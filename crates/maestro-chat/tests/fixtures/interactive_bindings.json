  {
    "test": "session_binding_waits_for_extensions_before_completion_shortcuts_resources_and_notices",
    "input": {
      "op": "binding",
      "fail": null
    },
    "expected": {
      "calls": [
        "bind",
        "themes",
        "autocomplete",
        "shortcuts",
        "resources",
        "notices"
      ],
      "uiForwarded": true
    }
  },
  {
    "test": "session_binding_waits_for_extensions_before_completion_shortcuts_resources_and_notices",
    "input": {
      "op": "binding",
      "fail": "bind"
    },
    "expected": {
      "calls": [
        "bind"
      ],
      "uiForwarded": true,
      "error": "failed bind"
    }
  },
  {
    "test": "session_binding_waits_for_extensions_before_completion_shortcuts_resources_and_notices",
    "input": {
