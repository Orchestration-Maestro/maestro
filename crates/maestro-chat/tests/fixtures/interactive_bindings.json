    },
    "expected": {
      "calls": [],
      "requested": true
    }
  },
  {
    "test": "session_binding_forwards_native_shutdown_and_extension_errors",
    "input": {
      "op": "bound-shutdown-transition",
      "before": false,
      "after": true
    },
    "expected": {
      "calls": [],
      "requested": true
    }
  },
  {
    "test": "session_binding_forwards_native_shutdown_and_extension_errors",
    "input": {
      "op": "bound-shutdown-transition",
      "before": true,
      "after": false
    },
    "expected": {
      "calls": [
        "shutdown"
      ],
      "requested": true
    }
  },
  {
    "test": "session_binding_forwards_native_shutdown_and_extension_errors",
    "input": {
      "op": "bound-error",
      "stack": null
    },
    "expected": {
      "calls": [
        {
          "extensionPath": "/extensions/bound",
          "error": "binding failure"
        }
      ]
    }
  },
  {
    "test": "session_binding_forwards_native_shutdown_and_extension_errors",
    "input": {
      "op": "bound-error",
      "stack": "head\n  frame"
    },
    "expected": {
      "calls": [
        {
          "extensionPath": "/extensions/bound",
          "error": "binding failure",
          "stack": "head\n  frame"
        }
      ]
    }
  },
  {
    "test": "extension_errors_keep_the_heading_and_trimmed_stack_tail",
    "input": {
      "op": "extension-error",
      "stack": null
    },
    "expected": {
      "lines": [
        " @error@Extension \"/extensions/a\" error: failure\u001b[39m                                       "
      ],
      "texts": [
        "@error@Extension \"/extensions/a\" error: failure\u001b[39m"
      ],
      "children": 1,
      "renderRequested": true
    }
  },
  {
    "test": "extension_errors_keep_the_heading_and_trimmed_stack_tail",
    "input": {
      "op": "extension-error",
      "stack": ""
    },
    "expected": {
      "lines": [
        " @error@Extension \"/extensions/a\" error: failure\u001b[39m                                       "
      ],
      "texts": [
