  {
    "test": "runtime_settings_propagate_hardware_cursor_errors",
    "input": {
      "op": "settings",
      "padding": 0,
      "max": 5,
      "hardware": false,
      "clear": true,
      "hidden": true,
      "compact": false,
      "failHardware": true
    },
    "expected": {
      "calls": [
        "session",
        [
          "compact",
          false
        ],
        [
          "cwd",
          "/controlled"
        ],
        [
          "hardware",
          false
        ]
      ],
      "hidden": true,
      "error": "cursor rejected"
    }
  },
  {
    "test": "session_rebinding_unsubscribes_before_settings_binding_and_subscription",
    "input": {
      "op": "rebind",
      "subscription": false,
      "fail": null
    },
    "expected": {
      "calls": [
        "applyRuntimeSettings",
        "bindCurrentSessionExtensions",
        "subscribeToAgent",
        "updateAvailableProviderCount",
        "updateEditorBorderColor",
        "updateTerminalTitle"
      ],
      "unsubscribeCleared": true
    }
  },
  {
    "test": "session_rebinding_stops_at_each_failed_phase",
    "input": {
      "op": "rebind",
      "subscription": false,
      "fail": "applyRuntimeSettings"
    },
    "expected": {
      "calls": [
        "applyRuntimeSettings"
      ],
      "unsubscribeCleared": true,
      "error": "failed applyRuntimeSettings"
    }
  },
  {
    "test": "session_rebinding_stops_at_each_failed_phase",
