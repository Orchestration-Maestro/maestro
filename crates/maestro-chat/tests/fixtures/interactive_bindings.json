  {
    "test": "session_binding_forwards_native_shutdown_and_extension_errors",
    "input": {
      "op": "bound-shutdown",
      "streaming": false,
      "before": false
    },
    "expected": {
      "calls": [
        "shutdown"
      ],
      "requested": true
    }
  },
  {
    "test": "session_binding_forwards_native_shutdown_and_extension_errors",
    "input": {
      "op": "bound-shutdown",
      "streaming": false,
      "before": true
    },
    "expected": {
      "calls": [
        "shutdown"
      ],
      "requested": true
    }
  },
  {
    "test": "session_binding_forwards_native_shutdown_and_extension_errors",
    "input": {
      "op": "bound-shutdown",
      "streaming": true,
      "before": false
    },
    "expected": {
      "calls": [],
      "requested": true
    }
  },
  {
    "test": "session_binding_forwards_native_shutdown_and_extension_errors",
    "input": {
      "op": "bound-shutdown",
      "streaming": true,
