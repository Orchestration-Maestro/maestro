  },
  {
    "test": "extension_errors_keep_the_heading_and_trimmed_stack_tail",
    "input": {
      "op": "extension-error",
      "stack": "head\n at first \n at second"
    },
    "expected": {
      "lines": [
        " @error@Extension \"/extensions/a\" error: failure\u001b[39m                                       ",
        " @dim@  at first\u001b[39m                                                                     ",
        " @dim@  at second\u001b[39m                                                                    "
      ],
      "texts": [
        "@error@Extension \"/extensions/a\" error: failure\u001b[39m",
        "@dim@  at first\u001b[39m\n@dim@  at second\u001b[39m"
      ],
      "children": 2,
      "renderRequested": true
    }
  },
