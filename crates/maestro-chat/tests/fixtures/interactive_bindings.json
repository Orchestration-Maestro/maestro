[
  {
    "test": "runtime_settings_follow_the_current_session_without_crossing_policies",
    "input": {
      "op": "settings",
      "padding": 0,
      "max": 5,
      "hardware": false,
      "clear": true,
      "hidden": true,
      "compact": false
    },
    "expected": {
      "calls": [
        "session",
        [
          "compact",
          false
        ],
        [
          "cwd",
          "/controlled"
        ],
        [
          "hardware",
          false
        ],
        [
          "clear",
          true
        ],
        [
          "padding",
          0
        ],
        [
          "max",
          5
        ]
      ],
      "hidden": true
    }
  },
