    "test": "resource_home_lookup_preserves_absent_and_supplied_home_and_corrects_empty_prefix",
    "input": {
      "op": "native-home",
      "mode": "absent",
      "path": "/tmp/supplied-home/file"
    },
    "expected": {
      "value": "/tmp/supplied-home/file"
    }
  },
  {
    "test": "resource_home_lookup_preserves_absent_and_supplied_home_and_corrects_empty_prefix",
    "input": {
      "op": "native-home",
      "mode": "supplied",
      "path": "/tmp/supplied-home/file"
    },
    "expected": {
      "value": "~/file"
    }
  },
  {
    "test": "resource_home_lookup_preserves_absent_and_supplied_home_and_corrects_empty_prefix",
    "input": {
      "op": "native-home",
      "mode": "empty",
      "path": "/tmp/supplied-home/file"
    },
    "expected": {
      "value": "/tmp/supplied-home/file"
