  {
    "test": "empty_resources_do_not_add_chat_children",
    "input": {
      "op": "listing",
      "startup": {
        "expanded": false
      }
    },
    "expected": {
      "before": [],
      "expanded": [],
      "collapsed": [],
      "children": 0
    }
  },
  {
    "test": "empty_resources_do_not_add_chat_children",
    "input": {
      "op": "listing",
      "startup": {
        "expanded": true
      }
    },
    "expected": {
      "before": [],
      "expanded": [],
      "collapsed": [],
      "children": 0
    }
  },
  {
    "test": "context_resources_keep_discovery_order_and_relative_paths",
    "input": {
      "op": "listing",
      "cwd": "/home/user/Development/maestro",
      "context": [
        {
          "path": "/home/user/.maestro/agent/AGENTS.md"
        },
        {
          "path": "/home/user/Development/maestro/AGENTS.md"
        },
        {
          "path": "/outside/AGENTS.md"
        }
      ]
    },
    "expected": {
      "before": [
        "",
        "@mdHeading@[Context]\u001b[39m                                                                                                                                                                                                                   ",
        "@dim@  ~/.maestro/agent/AGENTS.md, AGENTS.md, /outside/AGENTS.md\u001b[39m                                                                                                                                                                 ",
        ""
      ],
      "expanded": [
        "",
        "@mdHeading@[Context]\u001b[39m                                                                                                                                                                                                                   ",
        "@dim@  ~/.maestro/agent/AGENTS.md\u001b[39m                                                                                                                                                                                                ",
        "@dim@  ~/Development/maestro/AGENTS.md\u001b[39m                                                                                                                                                                                           ",
        "@dim@  /outside/AGENTS.md\u001b[39m                                                                                                                                                                                                        ",
        ""
      ],
      "collapsed": [
        "",
        "@mdHeading@[Context]\u001b[39m                                                                                                                                                                                                                   ",
        "@dim@  ~/.maestro/agent/AGENTS.md, AGENTS.md, /outside/AGENTS.md\u001b[39m                                                                                                                                                                 ",
        ""
      ],
      "children": 3
    }
  },
