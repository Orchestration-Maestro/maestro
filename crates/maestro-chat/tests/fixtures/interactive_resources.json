  {
    "test": "loaded_resource_sections_retain_content_across_redraws",
    "input": {
      "op": "listing",
      "startup": {
        "expanded": true
      },
      "context": [
        {
          "path": "/work/\u001b[7m \u001b[27m.md"
        }
      ],
      "width": 40
    },
    "expected": {
      "before": [
        "",
        "@mdHeading@[Context]\u001b[39m                               ",
        "@dim@  /work/\u001b[7m \u001b[27m.md\u001b[39m                            ",
        ""
      ],
      "expanded": [
        "",
        "@mdHeading@[Context]\u001b[39m                               ",
        "@dim@  /work/\u001b[7m \u001b[27m.md\u001b[39m                            ",
        ""
      ],
      "collapsed": [
        "",
        "@mdHeading@[Context]\u001b[39m                               ",
        "@dim@  /work/\u001b[7m \u001b[27m.md\u001b[39m                            ",
        ""
      ],
      "children": 3
    }
  },
  {
    "test": "context_resources_resolve_lexically_without_touching_files",
    "input": {
      "op": "context",
      "cwd": "/work/project",
      "path": ".",
      "home": "/home/user"
    },
    "expected": {
      "value": "."
    }
  },
  {
    "test": "context_resources_resolve_lexically_without_touching_files",
    "input": {
      "op": "context",
      "cwd": "/work/project",
      "path": "nested/../AGENTS.md",
      "home": "/home/user"
    },
    "expected": {
      "value": "AGENTS.md"
    }
  },
  {
    "test": "context_resources_resolve_lexically_without_touching_files",
    "input": {
      "op": "context",
      "cwd": "/work/project",
      "path": "./界/../a.md",
      "home": "/home/user"
    },
    "expected": {
      "value": "a.md"
    }
  },
  {
    "test": "context_resources_resolve_lexically_without_touching_files",
