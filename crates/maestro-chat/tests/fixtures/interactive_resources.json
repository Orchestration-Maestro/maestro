  {
    "test": "resource_paths_abbreviate_supplied_home_prefix",
    "input": {
      "op": "display",
      "path": "/home/user",
      "home": "/home/user"
    },
    "expected": {
      "value": "~"
    }
  },
  {
    "test": "resource_paths_abbreviate_supplied_home_prefix",
    "input": {
      "op": "display",
      "path": "/home/user/child",
      "home": "/home/user"
    },
    "expected": {
      "value": "~/child"
    }
  },
  {
    "test": "resource_paths_abbreviate_supplied_home_prefix",
    "input": {
      "op": "display",
      "path": "/home/user-sibling/a",
      "home": "/home/user"
    },
    "expected": {
      "value": "~-sibling/a"
    }
  },
  {
    "test": "resource_paths_abbreviate_supplied_home_prefix",
    "input": {
      "op": "display",
      "path": "/outside/a",
      "home": "/home/user"
    },
    "expected": {
      "value": "/outside/a"
    }
  },
