  {
    "test": "compaction_labels_keep_reason_live_keys_and_editor",
    "input": {
      "op": "start-end",
      "reason": "manual",
      "progress": false,
      "previous": true
    },
    "expected": {
      "start": {
        "status": [
          "",
          " @accent@⠋\u001b[39m @muted@Compacting context... (escape to cancel)\u001b[39m                                                         "
        ],
        "chat": [],
        "progress": [],
        "timers": [
          80
        ],
        "editor": "draft"
      },
      "end": {
        "status": [],
        "chat": [
          "",
          " @error@Error: Compaction cancelled\u001b[39m                                                                        "
        ],
        "progress": [],
        "timers": [],
        "editor": "draft"
      },
      "restored": true
    }
  },
