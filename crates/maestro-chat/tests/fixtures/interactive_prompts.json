  {
    "test": "startup_prompt_failures_do_not_stop_following_input",
    "input": {
      "options": {
        "initialMessage": "first",
        "initialImages": [
          {
            "type": "image",
            "data": "ZmFrZQ==",
            "mimeType": "image/png"
          }
        ],
        "initialMessages": [
          "additional",
          "tail"
        ]
      },
      "typed": [
        "typed",
        "after"
      ],
      "failures": {
        "first": "error"
      }
    },
    "expected": [
      {
        "refused": "first"
      },
      {
        "prompt": "additional",
        "images": null,
        "session": "old"
      },
      {
        "prompt": "tail",
        "images": null,
        "session": "old"
      },
      {
        "prompt": "typed",
        "images": null,
        "session": "old"
      },
      {
        "prompt": "after",
        "images": null,
        "session": "old"
      }
    ]
  },
