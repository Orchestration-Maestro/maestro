  {
    "test": "startup_prompts_keep_order_images_empty_messages_and_error_recovery",
    "input": {
      "options": {
        "migratedProviders": [
          "zeta",
          "alpha",
          "zeta"
        ],
        "modelFallbackMessage": "restored fallback",
        "initialMessage": "first",
        "initialImages": [
          {
            "type": "image",
            "data": "ZmFrZQ==",
            "mimeType": "image/png"
          }
        ],
        "initialMessages": [
          "",
          "  extra  ",
          "repeat",
          "repeat"
        ]
      },
      "catalogError": "bad catalog",
      "typed": [
        "typed"
      ]
    },
    "expected": [
      {
        "warning": "Migrated credentials to auth.json: zeta, alpha, zeta"
      },
      {
        "catalogError": "bad catalog"
      },
      {
        "warning": "restored fallback"
      },
      {
        "prompt": "first",
        "images": [
          {
            "type": "image",
            "data": "ZmFrZQ==",
            "mimeType": "image/png"
          }
        ],
        "session": "old"
      },
      {
        "prompt": "",
        "images": null,
        "session": "old"
      },
      {
        "prompt": "  extra  ",
        "images": null,
        "session": "old"
      },
      {
        "prompt": "repeat",
        "images": null,
        "session": "old"
      },
      {
        "prompt": "repeat",
        "images": null,
        "session": "old"
      },
      {
        "prompt": "typed",
        "images": null,
        "session": "old"
      }
    ]
  },
