[
  {
    "test": "unchanged_theme_does_not_enqueue_a_setting_write",
    "input": {
      "op": "set-theme",
      "name": "dark"
    },
    "expected": {
      "result": {
        "success": true
      },
      "writes": [],
      "renderRequested": true
    }
  },
  {
    "test": "named_theme_switch_persists_before_redraw",
    "input": {
      "op": "set-theme",
      "name": "light"
    },
    "expected": {
      "result": {
        "success": true
      },
      "writes": [
        "light"
      ],
      "renderRequested": true
    }
  },
  {
    "test": "theme_rejection_does_not_persist_or_redraw",
    "input": {
      "op": "set-theme",
      "name": "__missing_theme__"
    },
    "expected": {
      "result": {
        "success": false,
        "error": "Theme not found: __missing_theme__"
      },
      "writes": [],
      "renderRequested": false
    }
  },
  {
    "test": "theme_instances_publish_without_changing_the_saved_name",
    "input": {
      "op": "set-theme-instance"
    },
    "expected": {
      "result": {
        "success": true
      },
      "writes": [],
      "publishedError": "@error@probe\u001b[39m",
      "renderRequested": true
    }
  },
  {
    "test": "theme_queries_keep_lookup_separate_from_live_publication",
    "input": {
      "op": "theme-queries"
    },
    "expected": {
      "names": [
        "dark",
        "light"
      ],
      "missing": null,
      "lookupDoesNotPublish": true,
      "retainedLivePublishes": true
    }
  },
  {
    "test": "editor_context_uses_bracketed_paste_and_expanded_text",
    "input": {
      "op": "editor-access",
      "text": ""
    },
    "expected": {
      "set": "",
      "pasted": "paste\n界",
      "raw": "paste\n界"
    }
  },
  {
    "test": "editor_context_uses_bracketed_paste_and_expanded_text",
    "input": {
      "op": "editor-access",
      "text": "\ufeff text "
    },
    "expected": {
      "set": "\ufeff text ",
      "pasted": "\ufeff text paste\n界",
      "raw": "\ufeff text paste\n界"
    }
  },
  {
    "test": "editor_context_uses_bracketed_paste_and_expanded_text",
    "input": {
      "op": "editor-access",
      "text": "first\nsecond"
    },
    "expected": {
      "set": "first\nsecond",
      "pasted": "first\nsecondpaste\n界",
      "raw": "first\nsecondpaste\n界"
    }
  },
  {
    "test": "terminal_title_forwards_the_supplied_text",
    "input": {
      "op": "set-title",
      "text": ""
    },
    "expected": {
      "title": ""
    }
  },
  {
    "test": "terminal_title_forwards_the_supplied_text",
    "input": {
      "op": "set-title",
      "text": "title\u001b]0;raw\u0007"
    },
    "expected": {
      "title": "title\u001b]0;raw\u0007"
    }
  },
  {
    "test": "terminal_title_forwards_the_supplied_text",
    "input": {
      "op": "set-title",
      "text": "界\nnext"
    },
    "expected": {
      "title": "界\nnext"
    }
  },
  {
    "test": "ui_tool_expansion_reaches_the_existing_transcript_owner",
    "input": {
      "op": "tool-expansion-forward",
      "expanded": false
    },
    "expected": {
      "before": false,
      "selected": [
        true
      ]
    }
  },
  {
    "test": "ui_tool_expansion_reaches_the_existing_transcript_owner",
    "input": {
      "op": "tool-expansion-forward",
      "expanded": true
    },
    "expected": {
      "before": true,
      "selected": [
        false
      ]
    }
  }
]
