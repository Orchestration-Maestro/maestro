  {
    "test": "compact_path_labels_keep_empty_root_and_separator_rules",
    "input": {
      "op": "compact-path",
      "path": "/"
    },
    "expected": {
      "value": "/"
    }
  },
  {
    "test": "compact_path_labels_keep_empty_root_and_separator_rules",
    "input": {
      "op": "compact-path",
      "path": "~"
    },
    "expected": {
      "value": "~"
    }
  },
  {
    "test": "compact_path_labels_keep_empty_root_and_separator_rules",
