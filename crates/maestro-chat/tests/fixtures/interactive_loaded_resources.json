  {
    "test": "extension_and_theme_sections_keep_owned_content_across_theme_and_owner_changes",
    "input": {
      "op": "theme-toggle",
      "kind": "theme",
      "themes": [
        {
          "name": "retained",
          "sourcePath": "/retained/theme.json"
        }
      ]
    },
    "expected": {
      "before": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                ",
        "@dim@  retained\u001b[39m                                                                                                              ",
        ""
      ],
      "noToggle": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                ",
        "@dim@  retained\u001b[39m                                                                                                              ",
        ""
      ],
      "expanded": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                ",
        "  @accent@project\u001b[39m                                                                                                               ",
        "@dim@    /retained/theme.json\u001b[39m                                                                                                ",
        ""
      ],
      "collapsed": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                ",
        "@dim@  retained\u001b[39m                                                                                                              ",
        ""
      ]
    }
  },
  {
    "test": "resource_home_queries_follow_the_reached_formatting_branch",
