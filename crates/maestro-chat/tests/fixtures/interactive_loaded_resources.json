  {
    "test": "theme_listing_omits_unlocated_and_keeps_empty_named_theme",
    "input": {
      "op": "listing",
      "expanded": false,
      "themes": [
        {
          "name": "dark"
        },
        {
          "name": "dark",
          "sourcePath": "/custom/dark.json"
        },
        {
          "name": "light",
          "sourcePath": ""
        },
        {
          "name": "zeta",
          "sourcePath": "/zeta.json"
        },
        {
          "sourcePath": "/pkg/theme.json",
          "sourceInfo": {
            "source": "npm:pkg",
            "scope": "user",
            "baseDir": "/pkg"
          }
        },
        {
          "name": "",
          "sourcePath": "/empty-name.json"
        },
        {
          "name": "\ufeff trimmed \ufeff",
          "sourcePath": "/trim.json"
        },
        {
          "name": "\u0085kept\u0085",
          "sourcePath": "/kept.json"
        }
      ]
    },
    "expected": {
      "before": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                                                                                                                                        ",
        "@dim@  \u0085kept\u0085, dark, theme.json, trimmed, zeta\u001b[39m                                                                                                                                                                                                         ",
        ""
      ],
      "expanded": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                                                                                                                                        ",
        "  @accent@project\u001b[39m                                                                                                                                                                                                                                       ",
        "@dim@    /custom/dark.json\u001b[39m                                                                                                                                                                                                                           ",
        "@dim@    /empty-name.json\u001b[39m                                                                                                                                                                                                                            ",
        "@dim@    /kept.json\u001b[39m                                                                                                                                                                                                                                  ",
        "@dim@    /trim.json\u001b[39m                                                                                                                                                                                                                                  ",
        "@dim@    /zeta.json\u001b[39m                                                                                                                                                                                                                                  ",
        "  @accent@user\u001b[39m                                                                                                                                                                                                                                          ",
        "    @mdLink@npm:pkg\u001b[39m                                                                                                                                                                                                                                     ",
        "@dim@      theme.json\u001b[39m                                                                                                                                                                                                                                ",
        ""
      ],
      "collapsed": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                                                                                                                                        ",
        "@dim@  \u0085kept\u0085, dark, theme.json, trimmed, zeta\u001b[39m                                                                                                                                                                                                         ",
        ""
      ],
      "children": 2
    }
  },
