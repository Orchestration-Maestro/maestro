  {
    "test": "theme_listing_uses_scope_and_package_paths",
    "input": {
      "op": "listing",
      "expanded": true,
      "themes": [
        {
          "name": "user",
          "sourcePath": "/home/custom.json",
          "sourceInfo": {
            "source": "local",
            "scope": "user"
          }
        },
        {
          "name": "project",
          "sourcePath": "/pkg/themes/z.json",
          "sourceInfo": {
            "source": "npm:pkg",
            "scope": "project",
            "baseDir": "/pkg"
          }
        },
        {
          "sourcePath": "/tmp/custom.json",
          "sourceInfo": {
            "source": "cli",
            "scope": "temporary"
          }
        }
      ]
    },
    "expected": {
      "before": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                                                                                                                                        ",
        "  @accent@project\u001b[39m                                                                                                                                                                                                                                       ",
        "    @mdLink@npm:pkg\u001b[39m                                                                                                                                                                                                                                     ",
        "@dim@      themes/z.json\u001b[39m                                                                                                                                                                                                                             ",
        "  @accent@user\u001b[39m                                                                                                                                                                                                                                          ",
        "@dim@    /home/custom.json\u001b[39m                                                                                                                                                                                                                           ",
        "  @accent@path\u001b[39m                                                                                                                                                                                                                                          ",
        "@dim@    /tmp/custom.json\u001b[39m                                                                                                                                                                                                                            ",
        ""
      ],
      "expanded": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                                                                                                                                        ",
        "  @accent@project\u001b[39m                                                                                                                                                                                                                                       ",
        "    @mdLink@npm:pkg\u001b[39m                                                                                                                                                                                                                                     ",
        "@dim@      themes/z.json\u001b[39m                                                                                                                                                                                                                             ",
        "  @accent@user\u001b[39m                                                                                                                                                                                                                                          ",
        "@dim@    /home/custom.json\u001b[39m                                                                                                                                                                                                                           ",
        "  @accent@path\u001b[39m                                                                                                                                                                                                                                          ",
        "@dim@    /tmp/custom.json\u001b[39m                                                                                                                                                                                                                            ",
        ""
      ],
      "collapsed": [
        "@mdHeading@[Themes]\u001b[39m                                                                                                                                                                                                                                        ",
        "@dim@  custom.json, project, user\u001b[39m                                                                                                                                                                                                                    ",
        ""
      ],
      "children": 2
    }
  },
