  {
    "test": "queued_texts_merge_by_mode_without_reordering_or_deduplication",
    "input": {
      "op": "merge-clear",
      "steering": [
        "s",
        "s"
      ],
      "followUp": [
        "f"
      ],
      "local": [
        {
          "text": "lf",
          "mode": "followUp"
        },
        {
          "text": "ls",
          "mode": "steer"
        }
      ]
    },
    "expected": {
      "before": {
        "steering": [
          "s",
          "s",
          "ls"
        ],
        "followUp": [
          "f",
          "lf"
        ]
      },
      "cleared": {
        "steering": [
          "s",
          "s",
          "ls"
        ],
        "followUp": [
          "f",
          "lf"
        ]
      },
      "after": {
        "calls": [
          [
            "clear"
          ]
        ],
        "local": [],
        "session": {
          "steering": [],
          "followUp": []
        },
        "text": "",
        "history": [],
        "errors": [],
        "aborts": 0,
        "pending": [],
        "chat": []
      }
    }
  },
