      "stored": "[paste #1 +13 lines]",
      "expanded": "current\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\n"
    },
    "expected": {
      "text": "[paste #1 +13 lines]",
      "handoff": {
        "args": [
          "--wait"
        ],
        "text": "current\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\ncurrent\n",
        "mode": 384
      }
    }
  },
