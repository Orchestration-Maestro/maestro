[
  {
    "test": "border_text_change_uses_the_shared_whitespace_domain",
    "input": {
      "op": "change",
      "initial": false,
      "text": ""
    },
    "expected": {
      "shell": false,
      "border": "\u2501"
    }
  },
  {
    "test": "border_text_change_uses_the_shared_whitespace_domain",
    "input": {
      "op": "change",
      "initial": false,
      "text": "!"
    },
    "expected": {
      "shell": true,
      "border": "@bashMode@\u2501\u001b[39m"
    }
  },
  {
    "test": "border_text_change_uses_the_shared_whitespace_domain",
    "input": {
      "op": "change",
      "initial": false,
      "text": " !run"
    },
    "expected": {
      "shell": true,
      "border": "@bashMode@\u2501\u001b[39m"
    }
  },
