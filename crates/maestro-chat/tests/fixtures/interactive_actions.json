  {
    "test": "clipboard_paste_keeps_image_bytes_and_inserts_at_the_cursor",
    "input": {
      "op": "paste",
      "type": "image/png"
    },
    "expected": {
      "bytes": [
        0,
        255,
        128,
        10
      ],
      "extension": "png",
      "text": "left<image-path>right",
      "mode": 384
    }
  },
