  {
    "test": "logout_empty_command_restores_editor_and_reports_scope",
    "input": {
      "case": "exact",
      "text": "/logout",
      "saved": true
    },
    "expected": {
      "selector": true,
      "status": null,
      "ordinary": null
    }
  },
  {
    "test": "logout_empty_command_restores_editor_and_reports_scope",
    "input": {
      "case": "nothing-saved",
      "text": "/logout",
      "saved": false
    },
    "expected": {
      "selector": false,
      "status": "No stored credentials to remove. /logout only removes credentials saved by /login; environment variables and models.json config are unchanged.",
      "ordinary": null
    }
  },
  {
    "test": "logout_empty_command_restores_editor_and_reports_scope",
    "input": {
      "case": "extra-argument",
      "text": "/logout extra",
      "saved": true
    },
    "expected": {
      "selector": false,
      "status": null,
      "ordinary": "/logout extra"
    }
  },
