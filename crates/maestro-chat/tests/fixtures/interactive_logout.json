  {
    "test": "logout_selection_uses_current_session_with_captured_choice",
    "input": {
      "case": "replacement-session",
      "selected": "a",
      "providers": [
        {
          "id": "a",
          "models": [],
          "name": "First session"
        }
      ],
      "stored": [
        {
          "id": "a",
          "record": {
            "type": "api_key",
            "key": "saved"
          }
        }
      ],
      "replacement": [
        {
          "id": "a",
          "record": {
            "type": "oauth",
            "access": "access",
            "refresh": "refresh",
            "expires": 1
          }
        },
        {
          "id": "b",
          "record": {
            "type": "api_key",
            "key": "saved"
          }
        }
      ]
    },
    "expected": {
      "count": 1.0,
      "message": "Removed stored API key for First session. Environment variables and models.json config are unchanged.",
      "error": null,
      "accepted": [
        "b"
      ],
      "original": [
        "a"
      ]
    }
  },
  {
    "test": "logout_failures_keep_reached_effects_and_restore_focus",
    "input": {
      "case": "first-refresh",
      "selected": "a",
      "providers": [
        {
          "id": "a",
          "models": [
            "one"
          ],
          "key": true
        }
      ],
      "stored": [
        {
          "id": "a",
          "record": {
            "type": "api_key",
            "key": "saved"
          }
        }
      ]
    },
    "expected": {
      "count": 0.0,
      "message": null,
      "error": "Logout failed: refresh refused",
      "accepted": [
        "refusing"
      ]
    }
  },
