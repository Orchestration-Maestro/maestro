  {
    "test": "logout_selection_removes_only_chosen_saved_credential",
    "input": {
      "case": "subscription",
      "selected": "z",
      "providers": [
        {
          "id": "a",
          "models": [
            "one",
            "two"
          ],
          "key": true
        },
        {
          "id": "b",
          "models": [
            "one"
          ],
          "key": true
        },
        {
          "id": "z",
          "models": [],
          "name": "Saved account"
        }
      ],
      "stored": [
        {
          "id": "z",
          "record": {
            "type": "oauth",
            "access": "access",
            "refresh": "refresh",
            "expires": 1
          }
        },
        {
          "id": "a",
          "record": {
            "type": "api_key",
            "key": "saved"
          }
        }
      ]
    },
    "expected": {
      "count": 2.0,
      "message": "Logged out of Saved account",
      "error": null,
      "accepted": [
        "a"
      ]
    }
  },
  {
    "test": "logout_selection_removes_only_chosen_saved_credential",
    "input": {
      "case": "api-key",
      "selected": "z",
      "providers": [
        {
          "id": "a",
          "models": [
            "one"
          ],
          "key": true
        },
        {
          "id": "z",
          "models": [],
          "name": "Saved key"
        }
      ],
      "stored": [
        {
          "id": "a",
          "record": {
            "type": "oauth",
            "access": "access",
            "refresh": "refresh",
            "expires": 1
          }
        },
        {
          "id": "z",
          "record": {
            "type": "api_key",
            "key": "saved"
          }
        }
      ]
    },
    "expected": {
      "count": 1.0,
      "message": "Removed stored API key for Saved key. Environment variables and models.json config are unchanged.",
      "error": null,
      "accepted": [
        "a"
      ]
    }
  },
