[
  {
    "test": "logout_options_keep_saved_kinds_and_stable_names",
    "input": {
      "case": "empty",
      "stored": [],
      "configured": []
    },
    "expected": {
      "options": []
    }
  },
  {
    "test": "logout_options_keep_saved_kinds_and_stable_names",
    "input": {
      "case": "stored-only",
      "stored": [
        {
          "id": "z",
          "record": {
            "type": "oauth",
            "access": "access",
            "refresh": "refresh",
            "expires": 1
          },
          "name": "Zulu"
        },
        {
          "id": "a",
          "record": {
            "type": "api_key",
            "key": "saved"
          },
          "name": "Alpha"
        }
      ],
      "configured": [
        {
          "id": "environment-only",
          "models": [
            "one"
          ],
          "key": true
        },
        {
          "id": "model-file-only",
          "models": [
            "two"
          ],
          "key": true
        }
      ]
    },
    "expected": {
      "options": [
        {
          "id": "a",
          "name": "Alpha",
          "authType": "api_key"
        },
        {
          "id": "z",
          "name": "Zulu",
          "authType": "oauth"
        }
      ]
    }
  },
