  {
    "test": "logout_persistence_failure_remains_a_store_diagnostic",
    "input": {
      "case": "write-failure",
      "selected": "a",
      "providers": [],
      "stored": [
        {
          "id": "a",
          "record": {
            "type": "api_key",
            "key": "saved"
          }
        },
        {
          "id": "b",
          "record": {
            "type": "oauth",
            "access": "access",
            "refresh": "refresh",
            "expires": 1
          }
        }
      ]
    },
    "expected": {
      "count": 0.0,
      "message": "Removed stored API key for a. Environment variables and models.json config are unchanged.",
      "error": null,
      "accepted": [
        "b"
      ],
      "persisted": [
        "a",
        "b"
      ]
    }
  },
