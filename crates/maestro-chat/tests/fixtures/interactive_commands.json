  {
    "test": "new_session_stops_progress_honors_veto_and_uses_runtime_failure_route",
    "input": {
      "outcome": "success",
      "loader": false
    },
    "expected": {
      "outcome": "notice",
      "chat": [
        "",
        "                                                                                ",
        " @accent@✓ New session started\u001b[39m                                                          ",
        "                                                                                "
      ]
    }
  },
  {
    "test": "new_session_stops_progress_honors_veto_and_uses_runtime_failure_route",
    "input": {
      "outcome": "success",
      "loader": true
    },
    "expected": {
      "outcome": "notice",
      "chat": [
        "",
        "                                                                                ",
        " @accent@✓ New session started\u001b[39m                                                          ",
        "                                                                                "
      ]
    }
  },
  {
    "test": "new_session_stops_progress_honors_veto_and_uses_runtime_failure_route",
    "input": {
      "outcome": "veto",
      "loader": false
    },
    "expected": {
      "outcome": "kept"
    }
  },
  {
    "test": "new_session_stops_progress_honors_veto_and_uses_runtime_failure_route",
    "input": {
      "outcome": "veto",
      "loader": true
    },
    "expected": {
      "outcome": "kept"
    }
  },
  {
    "test": "new_session_stops_progress_honors_veto_and_uses_runtime_failure_route",
    "input": {
      "outcome": "reject",
      "loader": false
    },
    "expected": {
      "outcome": "fatal",
      "line": "Error: Failed to create session: controlled replacement failure"
    }
  },
  {
    "test": "new_session_stops_progress_honors_veto_and_uses_runtime_failure_route",
    "input": {
      "outcome": "reject",
      "loader": true
    },
    "expected": {
      "outcome": "fatal",
      "line": "Error: Failed to create session: controlled replacement failure"
    }
  },
  {
    "test": "new_session_stops_progress_honors_veto_and_uses_runtime_failure_route",
    "input": {
      "outcome": "replay-failure",
      "loader": false
    },
    "expected": {
      "outcome": "fatal",
      "line": "Error: Failed to create session: tool call id is not a string"
    }
  },
