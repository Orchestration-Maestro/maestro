  {
    "test": "countdown_disposal_is_idempotent_and_reentrant",
    "input": {
      "mode": "before"
    },
    "expected": {
      "events": [
        2
      ],
      "pending": 0
    }
  },
  {
    "test": "countdown_disposal_is_idempotent_and_reentrant",
    "input": {
      "mode": "in_tick"
    },
    "expected": {
      "events": [
        2,
        1,
        "render"
      ],
      "pending": 0
    }
  },
  {
    "test": "countdown_disposal_is_idempotent_and_reentrant",
    "input": {
      "mode": "in_terminal_tick"
    },
    "expected": {
      "events": [
        2,
        1,
        "render",
        0,
        "render",
        "expire"
      ],
      "pending": 0
    }
  },
  {
    "test": "countdown_disposal_is_idempotent_and_reentrant",
    "input": {
      "mode": "in_expire"
    },
    "expected": {
      "events": [
        2,
        1,
        "render",
        0,
        "render",
        "expire"
      ],
