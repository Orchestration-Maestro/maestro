  {
    "test": "share_and_copy_commands_clear_editor_after_completion",
    "input": {
      "text": "/share"
    },
    "expected": {
      "routed": true
    }
  },
  {
    "test": "share_and_copy_commands_clear_editor_after_completion",
    "input": {
      "text": "/copy"
    },
    "expected": {
      "routed": true
    }
  },
  {
    "test": "share_and_copy_commands_clear_editor_after_completion",
    "input": {
      "text": "/share extra"
    },
    "expected": {
      "routed": false
    }
  },
  {
    "test": "share_and_copy_commands_clear_editor_after_completion",
    "input": {
      "text": "/copy extra"
    },
    "expected": {
