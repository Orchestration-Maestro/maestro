            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0,
              "total": 0
            }
          },
          "stopReason": "stop",
          "timestamp": 1
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "  latest  "
            }
          ],
          "api": "faux",
          "provider": "faux",
          "model": "plain",
          "usage": {
            "input": 1,
            "output": 1,
            "cacheRead": 0,
            "cacheWrite": 0,
            "totalTokens": 2,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0,
              "total": 0
