[
  {
    "test": "share_failed_exit_keeps_trimmed_stderr_or_unknown_error",
    "input": {
      "code": 1,
      "stdout": "https://gist.github.com/alice/abc123",
      "stderr": "  permission denied\n"
    },
    "expected": {
      "kind": "error",
      "text": "Failed to create gist: permission denied"
    }
  },
  {
    "test": "share_failed_exit_keeps_trimmed_stderr_or_unknown_error",
    "input": {
      "code": 1,
      "stdout": "",
      "stderr": ""
    },
    "expected": {
      "kind": "error",
      "text": "Failed to create gist: Unknown error"
    }
  },
  {
    "test": "share_failed_exit_keeps_trimmed_stderr_or_unknown_error",
    "input": {
      "code": 1,
      "stdout": "",
      "stderr": "﻿ \t\r\n"
    },
    "expected": {
      "kind": "error",
      "text": "Failed to create gist: Unknown error"
    }
  },
  {
    "test": "share_failed_exit_keeps_trimmed_stderr_or_unknown_error",
    "input": {
      "code": 1,
      "stdout": "",
      "stderr": ""
    },
    "expected": {
      "kind": "error",
      "text": "Failed to create gist: "
    }
  },
  {
    "test": "share_failed_exit_keeps_trimmed_stderr_or_unknown_error",
    "input": {
      "code": null,
      "stdout": "",
      "stderr": "terminated"
    },
    "expected": {
      "kind": "error",
      "text": "Failed to create gist: terminated"
    }
  },
  {
