  {
    "test": "share_formats_gist_with_configured_or_empty_viewer",
    "input": {
      "code": 0,
      "stdout": "https://gist.github.com/alice/abc123\n",
      "stderr": "",
      "origin": ""
    },
    "expected": {
      "kind": "status",
      "text": "Gist: https://gist.github.com/alice/abc123"
    }
  },
  {
    "test": "share_formats_gist_with_configured_or_empty_viewer",
    "input": {
      "code": 0,
      "stdout": "https://gist.github.com/alice/abc123\n",
      "stderr": "",
      "origin": "https://viewer.example"
    },
    "expected": {
      "kind": "status",
      "text": "Share URL: https://viewer.example/session/#abc123\nGist: https://gist.github.com/alice/abc123"
    }
  },
