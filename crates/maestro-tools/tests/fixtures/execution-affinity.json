{
  "cases": [
    {
      "test": "local_factories_keep_declarations_and_presets",
      "id": "metadata-read",
      "input": {
        "name": "read"
      },
      "expected": {
        "name": "read",
        "label": "read",
        "description": "Read a file. Reads text files, plus images in jpg, png, gif or webp format that come back as attachments. Text output is cut at 2000 lines or 50KB, whichever limit is reached first. For large files, page through with offset and limit. When you need the whole file, keep continuing with offset until it is complete.",
        "parameters": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "File to read, as a relative or absolute path"
            },
            "offset": {
              "type": "number",
              "description": "First line to read, counting from 1"
            },
            "limit": {
              "type": "number",
              "description": "Upper bound on the lines returned"
            }
          }
        },
        "promptSnippet": "Read file contents",
        "promptGuidelines": [
          "Inspect files with read, not cat or sed."
        ]
      }
    },
    {
      "test": "local_factories_keep_declarations_and_presets",
      "id": "metadata-bash",
      "input": {
        "name": "bash"
      },
      "expected": {
        "name": "bash",
        "label": "bash",
        "description": "Run a bash command; it starts in the current working directory. The result carries stdout and stderr, and output keeps only the last 2000 lines or 50KB, whichever limit is reached first. When output is cut, the full output is saved to a temporary file. Accepts an optional timeout in seconds.",
        "parameters": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string",
              "description": "Bash command to execute"
            },
            "timeout": {
              "type": "number",
              "description": "Timeout in seconds (optional, no default timeout)"
            }
          }
        },
        "promptSnippet": "Execute bash commands (ls, grep, find, etc.)"
      }
    },
    {
      "test": "local_factories_keep_declarations_and_presets",
      "id": "metadata-edit",
      "input": {
        "name": "edit"
      },
      "expected": {
        "name": "edit",
        "label": "edit",
        "description": "Edit one file by replacing exact text. Each edits[].oldText must match exactly one region of the original file, and no two regions may overlap. Changes within one block or on adjacent lines belong in a single edit, not in overlapping edits. Never pad an edit with large unchanged regions just to join distant changes.",
        "parameters": {
          "type": "object",
          "required": [
            "path",
            "edits"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "File to edit, as a relative or absolute path"
            },
            "edits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "oldText",
                  "newText"
                ],
                "properties": {
                  "oldText": {
                    "type": "string",
                    "description": "Exact text that one targeted edit replaces. It must occur once in the original file and must not overlap any other edits[].oldText in the same call."
                  },
                  "newText": {
                    "type": "string",
                    "description": "Text that takes the place of oldText in this edit."
                  }
                },
                "additionalProperties": false
              },
              "description": "One or more targeted replacements. Every edit is located in the original file, never in the output of an earlier edit. Overlapping or nested edits are rejected. Changes within one block or on adjacent lines go into a single edit."
            }
          },
          "additionalProperties": false
        },
        "promptSnippet": "Replace exact text in a file, including several disjoint edits in one call",
        "promptGuidelines": [
          "Edit suits precise changes, and every edits[].oldText has to match the file exactly",
          "To change several separate places in one file, make a single edit call with one edits[] entry per place rather than several edit calls",
          "Each edits[].oldText is looked up in the original file, not in what earlier edits leave behind. Never emit overlapping or nested edits; fold nearby changes into one edit.",
          "Make edits[].oldText as short as it can be while still occurring once in the file. Never pad it with large unchanged regions."
        ],
        "renderShell": "self"
      }
    },
    {
      "test": "local_factories_keep_declarations_and_presets",
      "id": "metadata-write",
      "input": {
        "name": "write"
      },
      "expected": {
        "name": "write",
        "label": "write",
        "description": "Write content to a file, creating it when missing and overwriting it when present. Parent directories are created automatically.",
        "parameters": {
          "type": "object",
          "required": [
            "path",
            "content"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "File to write, as a relative or absolute path"
            },
            "content": {
              "type": "string",
              "description": "Content to write to the file"
            }
          }
        },
        "promptSnippet": "Create or overwrite files",
        "promptGuidelines": [
          "Reserve write for new files and complete rewrites."
        ]
      }
    },
    {
      "test": "local_factories_keep_declarations_and_presets",
      "id": "metadata-grep",
      "input": {
        "name": "grep"
      },
      "expected": {
        "name": "grep",
        "label": "grep",
        "description": "Find a pattern in file contents. Returns each matching line with its file path and line number. Honors .gitignore. Output stops at 100 matches or 50KB, whichever limit is reached first. Lines longer than 500 chars are cut.",
        "parameters": {
          "type": "object",
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Search pattern (regex or literal string)"
            },
            "path": {
              "type": "string",
              "description": "Directory or file to search (default: current directory)"
            },
            "glob": {
              "type": "string",
              "description": "Filter files by glob pattern, e.g. '*.ts' or '**/*.spec.ts'"
            },
            "ignoreCase": {
              "type": "boolean",
              "description": "Case-insensitive search (default: false)"
            },
            "literal": {
              "type": "boolean",
              "description": "Treat pattern as literal string instead of regex (default: false)"
            },
            "context": {
              "type": "number",
              "description": "Number of lines to show before and after each match (default: 0)"
            },
            "limit": {
              "type": "number",
              "description": "Largest number of matches returned (default: 100)"
            }
          }
        },
        "promptSnippet": "Search file contents for patterns (respects .gitignore)"
      }
    },
    {
      "test": "local_factories_keep_declarations_and_presets",
      "id": "metadata-find",
      "input": {
        "name": "find"
      },
      "expected": {
        "name": "find",
        "label": "find",
        "description": "Look up files with a glob pattern. Matches come back as paths relative to the directory searched. Honors .gitignore. Output stops at 1000 results or 50KB, whichever limit is reached first.",
        "parameters": {
          "type": "object",
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Glob pattern to match files, e.g. '*.ts', '**/*.json', or 'src/**/*.spec.ts'"
            },
            "path": {
              "type": "string",
              "description": "Directory to search in (default: current directory)"
            },
            "limit": {
              "type": "number",
              "description": "Largest number of results returned (default: 1000)"
            }
          }
        },
        "promptSnippet": "Find files by glob pattern (respects .gitignore)"
      }
    },
    {
      "test": "local_factories_keep_declarations_and_presets",
      "id": "metadata-ls",
      "input": {
        "name": "ls"
      },
      "expected": {
        "name": "ls",
        "label": "ls",
        "description": "List directory contents. Returns entries sorted alphabetically, with '/' suffix for directories. Includes dotfiles. Output is truncated to 500 entries or 50KB (whichever is hit first).",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Directory to list (default: current directory)"
            },
            "limit": {
              "type": "number",
              "description": "Largest number of entries returned (default: 500)"
            }
          }
        },
        "promptSnippet": "List directory contents"
      }
    },
