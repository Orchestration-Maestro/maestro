{
  "cases": [
    {
      "id": "custom_found",
      "kind": "shell_config",
      "input": {
        "custom": "/chosen shell",
        "exists": [
          "/chosen shell"
        ]
      },
      "expected": {
        "value": {
          "shell": "/chosen shell",
          "args": [
            "-c"
          ]
        },
        "trace": [
          [
            "exists",
            "/chosen shell"
          ]
        ]
      }
    },
    {
      "id": "custom_missing",
      "kind": "shell_config",
      "input": {
        "custom": "/missing",
        "exists": [
          "/bin/bash"
        ]
      },
      "expected": {
        "error": "Custom shell path not found: /missing",
        "trace": [
          [
            "exists",
            "/missing"
          ]
        ]
      }
    },
    {
