    {
      "id": "env_empty",
      "kind": "shell_env",
      "input": {},
      "expected": {
        "value": {
          "PATH": "/app/bin"
        }
      }
    },
    {
      "id": "env_path_empty",
      "kind": "shell_env",
      "input": {
        "env": {
          "PATH": "",
          "OTHER": "kept"
        }
      },
      "expected": {
        "value": {
          "PATH": "/app/bin",
          "OTHER": "kept"
        }
      }
    },
    {
      "id": "env_prepend",
      "kind": "shell_env",
      "input": {
        "env": {
          "PATH": "/usr/bin"
        }
      },
      "expected": {
        "value": {
          "PATH": "/app/bin:/usr/bin"
        }
      }
    },
    {
