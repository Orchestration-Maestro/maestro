  {
    "test": "loader_layout_delegates_wrapping_and_escapes_to_text",
    "input": {
      "message": "A\tB\n界 👩‍💻 é",
      "indicator": {
        "frames": []
      },
      "style": "identity",
      "width": 8
    },
    "expected": {
      "rows": [
        "",
        " A   B  ",
        " 界 👩‍💻  ",
        " é      "
      ],
      "calls": [
        [
          "message",
          "A\tB\n界 👩‍💻 é"
        ]
      ]
    }
  },
  {
    "test": "loader_layout_delegates_wrapping_and_escapes_to_text",
    "input": {
      "message": "\u001b[31mred\u001b[0m \u001b]8;;https://example.com\u0007link\u001b]8;;\u0007",
      "indicator": {
        "frames": []
      },
      "style": "identity",
      "width": 9
    },
    "expected": {
      "rows": [
        "",
        " \u001b[31mred\u001b[0m     ",
        " \u001b]8;;https://example.com\u0007link\u001b]8;;\u0007    "
      ],
      "calls": [
        [
          "message",
          "\u001b[31mred\u001b[0m \u001b]8;;https://example.com\u0007link\u001b]8;;\u0007"
        ]
      ]
    }
  },
