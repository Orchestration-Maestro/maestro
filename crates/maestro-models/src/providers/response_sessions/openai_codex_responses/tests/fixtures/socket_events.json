[
  {
    "scenario": "plain",
    "packets": [
      {
        "text": "{\"type\":\"response.created\",\"response\":{\"id\":\"r\"}}"
      },
      {
        "text": "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
      }
    ],
    "events": [
      "{\"type\":\"response.created\",\"response\":{\"id\":\"r\"}}",
      "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
    ]
  },
  {
    "scenario": "done",
    "packets": [
      {
        "text": "{\"type\":\"response.done\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
      }
    ],
    "events": [
      "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
    ]
  },
  {
    "scenario": "incomplete",
    "packets": [
      {
        "text": "{\"type\":\"response.incomplete\",\"response\":{\"id\":\"r\",\"status\":\"incomplete\"}}"
      }
    ],
    "events": [
      "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"incomplete\"}}"
    ]
  },
  {
    "scenario": "empty-and-untyped",
    "packets": [
      {
        "text": ""
      },
      {
        "text": "{}"
      },
      {
        "text": "{\"type\":null}"
      },
      {
        "text": "{\"type\":4}"
      },
      {
        "text": "{\"type\":\"\"}"
      },
      {
        "text": "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
      }
    ],
    "events": [
      "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
    ]
  },
  {
    "scenario": "unknown",
    "packets": [
      {
        "text": "{\"type\":\"new.kind\",\"kept\":[2,1,2]}"
      },
      {
        "text": "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
      }
    ],
    "events": [
      "{\"type\":\"new.kind\",\"kept\":[2,1,2]}",
      "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
    ]
  },
  {
    "scenario": "non-record",
    "packets": [
      {
        "text": "[]"
      },
      {
        "text": "[\"response.completed\",{}]"
      },
      {
        "text": "true"
      },
      {
        "text": "42"
      },
      {
        "text": "\"text\""
      },
      {
        "text": "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
      }
    ],
    "events": [
      "{\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"status\":\"completed\"}}"
    ]
  },
  {
    "scenario": "null-record",
    "packets": [
      {
        "text": "null"
      }
    ],
    "events": [],
    "error": {
      "name": "CodexProtocolError",
      "message": "Invalid Codex WebSocket JSON: <native cause>"
    }
  },
  {
    "scenario": "terminal-missing-response",
    "packets": [
      {
        "text": "{\"type\":\"response.completed\"}"
      }
    ],
    "events": [
      "{\"type\":\"response.completed\"}"
    ]
  },
  {
    "scenario": "terminal-null-response",
    "packets": [
      {
        "text": "{\"type\":\"response.done\",\"response\":null}"
      }
    ],
    "events": [
      "{\"type\":\"response.completed\",\"response\":null}"
    ]
  },
  {
    "scenario": "terminal-status-unknown",
    "packets": [
      {
        "text": "{\"type\":\"response.done\",\"response\":{\"status\":\"new-status\",\"unknown\":1}}"
