{
  "parser": [
    {
      "input": null,
      "expected": {}
    },
    {
      "input": "",
      "expected": {}
    },
    {
      "input": " \t\r\n",
      "expected": {}
    },
    {
      "input": "\ufeff",
      "expected": {}
    },
    {
      "input": "\u0085",
      "expected": {}
    },
    {
      "input": "\"text\"",
      "expected": "text"
    },
    {
      "input": "\"\"",
      "expected": ""
    },
    {
      "input": "\"raw\ncontrol\"",
      "expected": "raw\ncontrol"
    },
    {
      "input": "\"bad\\q\"",
      "expected": "bad\\q"
    },
    {
      "input": "\"partial",
      "expected": "partial"
    },
    {
      "input": "0",
      "expected": 0
    },
    {
      "input": "-0",
