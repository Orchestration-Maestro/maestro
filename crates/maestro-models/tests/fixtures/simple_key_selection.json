  {
    "test": "simple_key_selection_stays_shared_across_existing_providers",
    "input": {
      "api": "openai-completions",
      "provider": "google",
      "options": {
        "apiKey": "{account-token:b}"
      },
      "env": {
        "GEMINI_API_KEY": "{account-token:c}"
      }
    },
    "expected": {
      "key": "{account-token:b}"
