{
  "rows": [
    {
      "id": "schema-created-options",
      "test": "schema_creation_plan_preserves_order_and_existing_stores",
      "input": {
        "stores": [
          "inline",
          "plain"
        ],
        "existing": []
      },
      "expected": [
        "inline",
        "plain"
      ]
    },
    {
      "id": "schema-existing-is-untouched",
      "test": "schema_creation_plan_preserves_order_and_existing_stores",
      "input": {
        "stores": [
          "old",
          "new"
        ],
        "existing": [
          "old"
        ]
      },
      "expected": [
        "new"
      ]
    },
    {
      "id": "schema-duplicate-sees-earlier-create",
      "test": "schema_creation_plan_observes_prior_creations",
      "input": {
        "stores": [
          "same",
          "same"
        ],
        "existing": []
      },
      "expected": [
        "same"
      ]
    },
    {
      "id": "schema-index-defaults",
      "test": "schema_creation_plan_preserves_order_and_existing_stores",
      "input": {
        "stores": [
          "one"
        ],
        "existing": []
      },
      "expected": [
        "one"
      ]
    },
    {
      "id": "get-missing",
      "test": "schema_creation_plan_preserves_order_and_existing_stores",
      "input": {
        "stores": [],
        "existing": []
      },
      "expected": []
    },
    {
      "id": "put-outline",
      "test": "put_key_selection_uses_the_live_store_path",
      "input": {
        "inline": false,
        "key": "key"
      },
      "expected": "key"
    },
    {
      "id": "put-inline",
      "test": "put_key_selection_uses_the_live_store_path",
      "input": {
        "inline": true,
        "key": "key"
      },
      "expected": null
    },
    {
      "id": "put-empty-key",
      "test": "put_key_selection_uses_the_live_store_path",
      "input": {
        "inline": false,
        "key": ""
      },
      "expected": ""
    },
    {
      "id": "open-shared-failure",
      "test": "browser_storage_error_categories_keep_failure_kinds",
