{
  "csv": [
    {
      "test": "csv_range_and_empty_sheets",
      "id": "no-range",
      "input": {},
      "expected": {
        "csv": "",
        "cells": {}
      }
    },
    {
      "test": "csv_range_and_empty_sheets",
      "id": "singleton-empty",
      "input": {
        "!ref": "A1"
      },
      "expected": {
        "csv": "",
        "cells": {
          "!ref": "A1"
        }
      }
    },
    {
      "test": "csv_range_and_empty_sheets",
      "id": "offset-range",
      "input": {
        "!ref": "B2:C3",
        "B2": {
          "t": "s",
          "v": "b2"
        },
        "C3": {
          "t": "s",
          "v": "c3"
        },
        "A1": {
          "t": "s",
          "v": "outside"
        }
      },
      "expected": {
        "csv": "b2,\n,c3",
        "cells": {
          "!ref": "B2:C3",
          "B2": {
            "t": "s",
            "v": "b2",
            "w": "b2"
          },
          "C3": {
            "t": "s",
            "v": "c3",
            "w": "c3"
          },
          "A1": {
            "t": "s",
            "v": "outside"
          }
        }
      }
    },
    {
      "test": "csv_range_and_empty_sheets",
      "id": "cell-order-not-insertion",
      "input": {
        "!ref": "A1:B2",
        "B2": {
          "t": "s",
          "v": "last"
        },
        "A2": {
          "t": "s",
          "v": "third"
        },
        "B1": {
          "t": "s",
          "v": "second"
        },
        "A1": {
          "t": "s",
          "v": "first"
        }
      },
      "expected": {
        "csv": "first,second\nthird,last",
        "cells": {
          "!ref": "A1:B2",
          "B2": {
            "t": "s",
            "v": "last",
            "w": "last"
          },
          "A2": {
            "t": "s",
            "v": "third",
            "w": "third"
          },
          "B1": {
            "t": "s",
            "v": "second",
            "w": "second"
          },
          "A1": {
            "t": "s",
            "v": "first",
            "w": "first"
          }
        }
      }
    },
