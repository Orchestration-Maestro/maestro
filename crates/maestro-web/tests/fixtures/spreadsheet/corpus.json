    {
      "test": "csv_cached_text_and_scalar_fallback",
      "id": "cached-format",
      "input": {
        "!ref": "A1:C1",
        "A1": {
          "t": "n",
          "v": 1234.5,
          "w": "1,234.50"
        },
        "B1": {
          "t": "n",
          "v": 42,
          "w": ""
        },
        "C1": {
          "t": "s",
          "v": "raw",
          "w": "shown"
        }
      },
      "expected": {
        "csv": "\"1,234.50\",,shown",
        "cells": {
          "!ref": "A1:C1",
          "A1": {
            "t": "n",
            "v": 1234.5,
            "w": "1,234.50"
          },
          "B1": {
            "t": "n",
            "v": 42,
            "w": ""
          },
          "C1": {
            "t": "s",
            "v": "raw",
            "w": "shown"
          }
        }
      }
    },
    {
      "test": "csv_cached_text_and_scalar_fallback",
      "id": "typed-defaults",
      "input": {
        "!ref": "A1:E1",
        "A1": {
          "t": "n",
          "v": 0
        },
        "B1": {
          "t": "n",
          "v": {
            "number": "-0"
          }
        },
        "C1": {
          "t": "b",
          "v": true
        },
        "D1": {
          "t": "b",
          "v": false
        },
        "E1": {
          "t": "n",
          "v": 1e+21
        }
      },
      "expected": {
        "csv": "0,0,TRUE,FALSE,1E+21",
        "cells": {
          "!ref": "A1:E1",
          "A1": {
            "t": "n",
            "v": 0,
            "w": "0"
          },
          "B1": {
            "t": "n",
            "v": {
              "number": "-0"
            },
            "w": "0"
          },
          "C1": {
            "t": "b",
            "v": true,
            "w": "TRUE"
          },
          "D1": {
            "t": "b",
            "v": false,
            "w": "FALSE"
          },
          "E1": {
            "t": "n",
            "v": 1e+21,
            "w": "1E+21"
          }
        }
      }
    },
    {
      "test": "csv_cached_text_and_scalar_fallback",
      "id": "errors",
      "input": {
        "!ref": "A1:D1",
        "A1": {
          "t": "e",
          "v": 7,
          "w": "#DIV/0!"
        },
        "B1": {
          "t": "e",
          "v": 99
        },
        "C1": {
          "t": "e",
          "w": "#SPILL!"
        },
        "D1": {
          "t": "e",
          "v": 255
        }
      },
      "expected": {
        "csv": "#DIV/0!,99,,#WTF?",
        "cells": {
          "!ref": "A1:D1",
          "A1": {
            "t": "e",
            "v": 7,
            "w": "#DIV/0!"
          },
          "B1": {
            "t": "e",
            "v": 99
          },
          "C1": {
            "t": "e",
            "w": "#SPILL!"
          },
          "D1": {
            "t": "e",
            "v": 255
          }
        }
      }
    },
