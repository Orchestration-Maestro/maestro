  {
    "name": "unicode-and-markup-looking-session-id",
    "test": "session_download_uses_session_names_and_unicode_fallbacks",
    "input_json": "{\"header\":{\"id\":\"保存 🦀 <tag>&\\\"'\"},\"entries\":[]}",
    "expected": {
      "text": "{\"type\":\"header\",\"id\":\"保存 🦀 <tag>&\\\"'\"}",
      "mime": "application/x-ndjson",
      "file_name": "保存 🦀 <tag>&\"'.jsonl"
    }
  },
  {
    "name": "whitespace-session-id-is-not-trimmed",
    "test": "session_download_uses_session_names_and_unicode_fallbacks",
    "input_json": "{\"header\":{\"id\":\" ﻿ \"},\"entries\":[]}",
    "expected": {
      "text": "{\"type\":\"header\",\"id\":\" ﻿ \"}",
      "mime": "application/x-ndjson",
      "file_name": " ﻿ .jsonl"
    }
  },
  {
    "name": "nested-key-order-and-number-spelling",
    "test": "session_download_keeps_compact_json_order_and_number_spelling",
    "input_json": "{\"header\":{\"id\":\"numbers\",\"10\":\"ten\",\"2\":\"two\",\"tail\":true},\"entries\":[{\"type\":\"custom\",\"10\":10,\"2\":2,\"negativeZero\":-0,\"small\":1e-7,\"large\":1e21,\"rounded\":9007199254740993,\"nested\":{\"b\":1,\"1\":\"one\",\"a\":2}}]}",
    "expected": {
      "text": "{\"2\":\"two\",\"10\":\"ten\",\"type\":\"header\",\"id\":\"numbers\",\"tail\":true}\n{\"2\":2,\"10\":10,\"type\":\"custom\",\"negativeZero\":0,\"small\":1e-7,\"large\":1e+21,\"rounded\":9007199254740992,\"nested\":{\"1\":\"one\",\"b\":1,\"a\":2}}",
      "mime": "application/x-ndjson",
      "file_name": "numbers.jsonl"
    }
  },
  {
    "name": "unknown-record-fields-and-literal-content",
    "test": "session_download_keeps_compact_json_order_and_number_spelling",
    "input_json": "{\"header\":{\"id\":\"raw\"},\"entries\":[{\"type\":\"custom\",\"unknown\":[true,false,null,4,\"raw string\",{\"text\":\"<script>\\r\\n\\t🦀&\"},[\"raw array\"]]}]}",
    "expected": {
      "text": "{\"type\":\"header\",\"id\":\"raw\"}\n{\"type\":\"custom\",\"unknown\":[true,false,null,4,\"raw string\",{\"text\":\"<script>\\r\\n\\t🦀&\"},[\"raw array\"]]}",
      "mime": "application/x-ndjson",
      "file_name": "raw.jsonl"
    }
  },
  {
    "name": "no-header-no-entries",
    "test": "session_download_does_not_add_a_final_newline",
    "input_json": "{\"entries\":[]}",
    "expected": {
      "text": "",
      "mime": "application/x-ndjson",
      "file_name": "session.jsonl"
    }
  },
  {
    "name": "header-only",
    "test": "session_download_does_not_add_a_final_newline",
    "input_json": "{\"header\":{\"id\":\"one\"},\"entries\":[]}",
    "expected": {
      "text": "{\"type\":\"header\",\"id\":\"one\"}",
      "mime": "application/x-ndjson",
      "file_name": "one.jsonl"
    }
  },
  {
    "name": "entry-only",
    "test": "session_download_does_not_add_a_final_newline",
    "input_json": "{\"entries\":[{\"x\":\"line\\ninside\"}]}",
    "expected": {
      "text": "{\"x\":\"line\\ninside\"}",
      "mime": "application/x-ndjson",
      "file_name": "session.jsonl"
    }
  },
  {
    "name": "header-and-multiple-entries",
    "test": "session_download_does_not_add_a_final_newline",
    "input_json": "{\"header\":{\"id\":\"multi\"},\"entries\":[{\"n\":1},{\"n\":2}]}",
    "expected": {
      "text": "{\"type\":\"header\",\"id\":\"multi\"}\n{\"n\":1}\n{\"n\":2}",
      "mime": "application/x-ndjson",
      "file_name": "multi.jsonl"
    }
  }
