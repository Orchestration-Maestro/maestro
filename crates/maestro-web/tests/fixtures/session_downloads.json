[
  {
    "name": "all-branches-and-repeated-records",
    "test": "session_download_keeps_full_history_and_header_projection",
    "input_json": "{\"header\":{\"type\":\"session\",\"version\":3,\"id\":\"whole\",\"extra\":{\"note\":\"kept\"}},\"entries\":[{\"id\":\"root\",\"type\":\"message\",\"message\":{\"role\":\"user\",\"content\":\"start\"}},{\"id\":\"left\",\"parentId\":\"root\",\"type\":\"message\",\"message\":{\"role\":\"assistant\",\"content\":[]}},{\"id\":\"right\",\"parentId\":\"root\",\"type\":\"custom\",\"data\":{\"preserved\":true}},{\"id\":\"left\",\"parentId\":\"root\",\"type\":\"label\",\"targetId\":\"right\",\"label\":\"latest record\"}],\"leafId\":\"left\",\"tools\":[{\"name\":\"not-a-history-line\"}]}",
    "expected": {
      "text": "{\"type\":\"session\",\"version\":3,\"id\":\"whole\",\"extra\":{\"note\":\"kept\"}}\n{\"id\":\"root\",\"type\":\"message\",\"message\":{\"role\":\"user\",\"content\":\"start\"}}\n{\"id\":\"left\",\"parentId\":\"root\",\"type\":\"message\",\"message\":{\"role\":\"assistant\",\"content\":[]}}\n{\"id\":\"right\",\"parentId\":\"root\",\"type\":\"custom\",\"data\":{\"preserved\":true}}\n{\"id\":\"left\",\"parentId\":\"root\",\"type\":\"label\",\"targetId\":\"right\",\"label\":\"latest record\"}",
      "mime": "application/x-ndjson",
      "file_name": "whole.jsonl"
    }
  },
  {
    "name": "header-default-before-authored-members",
    "test": "session_download_keeps_full_history_and_header_projection",
    "input_json": "{\"header\":{\"id\":\"first\",\"z\":2,\"a\":1},\"entries\":[]}",
    "expected": {
      "text": "{\"type\":\"header\",\"id\":\"first\",\"z\":2,\"a\":1}",
      "mime": "application/x-ndjson",
      "file_name": "first.jsonl"
    }
  },
  {
    "name": "authored-header-type-replaces-default-without-moving-key",
    "test": "session_download_keeps_full_history_and_header_projection",
    "input_json": "{\"header\":{\"z\":2,\"type\":\"session\",\"id\":\"typed\"},\"entries\":[]}",
    "expected": {
      "text": "{\"type\":\"session\",\"z\":2,\"id\":\"typed\"}",
      "mime": "application/x-ndjson",
      "file_name": "typed.jsonl"
    }
  },
  {
    "name": "header-type-null-is-not-replaced",
    "test": "session_download_keeps_full_history_and_header_projection",
    "input_json": "{\"header\":{\"id\":\"typed-null\",\"type\":null},\"entries\":[]}",
    "expected": {
      "text": "{\"type\":null,\"id\":\"typed-null\"}",
      "mime": "application/x-ndjson",
      "file_name": "typed-null.jsonl"
    }
  },
  {
    "name": "header-type-false-is-not-replaced",
    "test": "session_download_keeps_full_history_and_header_projection",
    "input_json": "{\"header\":{\"id\":\"typed-false\",\"type\":false},\"entries\":[]}",
    "expected": {
      "text": "{\"type\":false,\"id\":\"typed-false\"}",
      "mime": "application/x-ndjson",
      "file_name": "typed-false.jsonl"
    }
  },
  {
    "name": "missing-header",
    "test": "session_download_uses_session_names_and_unicode_fallbacks",
    "input_json": "{\"entries\":[{\"type\":\"custom\",\"value\":\"header omitted\"}]}",
    "expected": {
      "text": "{\"type\":\"custom\",\"value\":\"header omitted\"}",
      "mime": "application/x-ndjson",
      "file_name": "session.jsonl"
    }
  },
  {
    "name": "null-header",
    "test": "session_download_uses_session_names_and_unicode_fallbacks",
    "input_json": "{\"header\":null,\"entries\":[{\"type\":\"custom\",\"value\":\"header null\"}]}",
    "expected": {
      "text": "{\"type\":\"custom\",\"value\":\"header null\"}",
      "mime": "application/x-ndjson",
      "file_name": "session.jsonl"
    }
  },
  {
