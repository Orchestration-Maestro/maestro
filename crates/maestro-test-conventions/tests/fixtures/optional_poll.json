    "test": "optional_poll_test_scopes_restore_production_ownership",
    "member": "maestro-tui",
    "files": {
      "src/lib.rs": "fn before() { let _ = futures_util::poll!(future); }\n#[cfg(test)]\nfn test_only() { let _ = futures_util::poll!(future); }\nstruct W;\nimpl W {\n    #[cfg(test)]\n    fn check() { assert!(futures_util::poll!(future).is_pending()); }\n    #[cfg(test)]\n    const TEST: () = { let _ = futures_util::poll!(future); };\n    fn after() { let _ = futures_util::poll!(future); }\n}\ntrait T {\n    #[cfg(test)]\n    fn check() { let _ = futures_util::poll!(future); }\n    #[cfg(test)]\n    const TEST: () = { let _ = futures_util::poll!(future); };\n    fn after() { let _ = futures_util::poll!(future); }\n}\n#[cfg(test)]\nmod tests { mod nested { fn check() { let _ = futures_util::poll!(future); } } }\nfn after() { let _ = futures_util::poll!(future); }\n"
    },
    "expected": [
      {
        "file": "src/lib.rs",
        "line": 3,
        "kind": "optional-poll"
      },
      {
        "file": "src/lib.rs",
        "line": 7,
        "kind": "optional-poll"
      },
      {
        "file": "src/lib.rs",
        "line": 9,
        "kind": "optional-poll"
      },
      {
        "file": "src/lib.rs",
        "line": 14,
        "kind": "optional-poll"
      },
      {
        "file": "src/lib.rs",
        "line": 16,
        "kind": "optional-poll"
      },
      {
        "file": "src/lib.rs",
        "line": 20,
        "kind": "optional-poll"
      }
    ]
  },
