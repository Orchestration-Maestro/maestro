        {
          "name": "tblInd",
          "style": [
            [
              "keep",
              "seed"
            ],
            [
              "table-layout",
              "handled"
            ]
          ]
        },
        {
          "name": "b",
          "style": [
            [
              "keep",
              "seed"
            ],
            [
              "table-layout",
              "handled"
            ],
            [
              "margin-inline-start",
              "handled"
            ]
          ]
        }
      ]
