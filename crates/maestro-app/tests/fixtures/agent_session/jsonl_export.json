      ]
    },
    {
      "id": "a1",
      "parentId": "u1",
      "keys": [
        "type",
        "id",
        "parentId",
        "timestamp",
        "message"
      ]
    },
    {
      "id": "u3",
      "parentId": "a1",
      "keys": [
        "type",
        "id",
        "parentId",
        "timestamp",
        "message"
      ]
    },
    {
      "id": "a3",
      "parentId": "u3",
      "keys": [
        "type",
        "id",
        "parentId",
        "timestamp",
        "message"
      ]
    }
  ],
  "defaultName": "$ROOT/exports/session-$STAMP.jsonl",
