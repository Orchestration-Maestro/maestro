[
  {
    "id": "posix-absolute-no-cwd",
    "input": {
      "probe": {
        "status": 0,
        "stdout": "/opt/tool/lib/node_modules\n",
        "stderr": ""
      },
      "npm_command": [
        "npm"
      ],
      "cwd_error": true
    },
    "expected": {
      "value": {
        "command": "npm",
        "args": [
          "install",
          "-g",
          "--ignore-scripts",
          "@old/agent"
