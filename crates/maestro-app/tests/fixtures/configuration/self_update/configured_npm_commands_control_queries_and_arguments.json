        "display": "npm --prefix /opt/tool uninstall -g @old/agent && npm --prefix /opt/tool install -g @new/maestro",
        "steps": [
          {
            "command": "npm",
            "args": [
              "--prefix",
              "/opt/tool",
              "uninstall",
              "-g",
              "@old/agent"
