[
  {
    "id": "configured-prefix",
    "input": {
      "npm_command": [
        "npm",
        "--prefix",
        "/opt/tool"
      ],
      "probe": {
        "status": 0,
        "stdout": "/opt/tool/lib/node_modules\n",
        "stderr": ""
      }
    },
    "expected": {
      "value": {
        "command": "npm",
        "args": [
          "--prefix",
          "/opt/tool",
          "install",
          "-g",
          "@old/agent"
        ],
        "display": "npm --prefix /opt/tool install -g @old/agent"
      }
    },
    "trace": [
      [
        "exists",
        "/opt/tool/lib/node_modules/@old/agent"
      ],
      [
        "canonicalize",
        "/opt/tool/lib/node_modules/@old/agent"
      ],
      [
        "command",
        "npm",
        [
          "--prefix",
          "/opt/tool",
          "root",
          "-g"
        ]
      ],
      [
        "exists",
        "/opt/tool/lib/node_modules"
      ],
      [
        "canonicalize",
        "/opt/tool/lib/node_modules"
      ],
      [
        "access",
        "/opt/tool/lib/node_modules/@old/agent"
      ],
      [
        "access",
        "/opt/tool/lib/node_modules/@old"
      ]
    ]
  },
