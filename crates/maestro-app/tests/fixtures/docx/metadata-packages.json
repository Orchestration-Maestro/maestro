          "kind": "CorePropsPart",
          "data": {
            "title": "from package",
            "revision": 2
          }
        },
        {
          "path": "docProps/custom.xml",
          "kind": "CustomPropsPart",
          "data": [
            {
              "formatId": "{fmt}",
              "name": "Named",
              "type": "vt:lpwstr",
              "value": "custom"
            }
          ]
        },
        {
          "path": "word/comments.xml",
          "kind": "CommentsPart",
          "data": {
            "comments": [
              {
                "cssStyle": [],
                "type": "comment",
                "id": "7",
                "author": "Author",
                "initials": "AU",
                "date": "2024-01-02T03:04:05Z",
                "children": {
                  "roots": [
                    0
                  ],
                  "nodes": [
                    {
                      "type": "paragraph",
                      "children": [
                        1,
                        4
                      ],
                      "cssStyle": [],
                      "styleName": "CommentText",
                      "keepNext": true
                    },
                    {
                      "type": "run",
                      "children": [
                        2,
                        3
                      ],
                      "cssStyle": [
                        [
                          "font-weight",
                          "bold"
                        ]
                      ],
                      "parent": 0
                    },
                    {
                      "type": "text",
                      "text": "A & B"
                    },
                    {
                      "type": "tab"
                    },
                    {
                      "type": "run",
                      "children": [
                        5
                      ],
                      "parent": 0
                    },
                    {
                      "type": "text",
                      "text": "second"
                    }
                  ]
                }
              }
            ],
            "lookup": [
              {
                "key": "7",
                "index": 0
              }
            ]
