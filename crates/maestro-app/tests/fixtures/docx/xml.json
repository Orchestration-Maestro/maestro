      "tree": {
        "local_name": "r",
        "namespace": null,
        "attributes": [
          {
            "local_name": "a",
            "namespace": null,
            "value": "x\ty z\nk l"
          }
        ],
        "children": [
          " a&b<c>\ud83d\ude00\n "
        ]
      },
      "element_names": [],
      "selected_x": [],
      "first_v": null,
      "missing": null,
      "text": " a&b<c>\ud83d\ude00\n "
    }
  },
