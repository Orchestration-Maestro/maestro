[
  {
    "test": "xml_children_and_attributes_keep_local_names_and_order",
    "input": {
      "xml": "<r xmlns=\"urn:r\" xmlns:a=\"urn:a\" xmlns:b=\"urn:b\" a:v=\"one\" b:v=\"two\" v=\"plain\">head<a:x n=\"first\"/><b:x n=\"second\"/><x n=\"third\"/>tail<!--ignored--><?keep value?></r>",
      "trim": false
    },
    "expected": {
      "tree": {
        "local_name": "r",
        "namespace": "urn:r",
        "attributes": [
          {
            "local_name": "v",
            "namespace": "urn:a",
            "value": "one"
          },
          {
            "local_name": "v",
            "namespace": "urn:b",
            "value": "two"
          },
          {
            "local_name": "v",
            "namespace": null,
            "value": "plain"
          }
        ],
        "children": [
          "head",
          {
            "local_name": "x",
            "namespace": "urn:a",
            "attributes": [
              {
                "local_name": "n",
                "namespace": null,
                "value": "first"
              }
            ],
            "children": []
          },
          {
            "local_name": "x",
            "namespace": "urn:b",
            "attributes": [
              {
                "local_name": "n",
                "namespace": null,
                "value": "second"
              }
            ],
            "children": []
          },
          {
            "local_name": "x",
            "namespace": "urn:r",
            "attributes": [
              {
                "local_name": "n",
                "namespace": null,
                "value": "third"
              }
            ],
            "children": []
          },
          "tail"
        ]
      },
      "element_names": [
        "x",
        "x",
        "x"
      ],
      "selected_x": [
        "first",
        "second",
        "third"
      ],
      "first_x": "first",
      "first_v": "one",
      "missing": null,
      "text": "headtail"
    }
  },
  {
    "test": "xml_entities_cdata_and_whitespace_survive",
