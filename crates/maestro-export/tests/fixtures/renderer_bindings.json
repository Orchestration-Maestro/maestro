    {
      "test": "export_prepared_results_survive_reentry_and_live_lookup",
      "input": {
        "case": "same-id-reentry",
        "outer_details": {
          "label": "outer"
        },
        "inner_details": {
          "label": "inner"
        }
      },
      "expected": {
        "output": {
          "collapsed": "<div class=\"ansi-line\">outer:false</div>",
          "expanded": "<div class=\"ansi-line\">outer:true</div>"
        },
        "events": [
          {
            "lookup": "outer",
            "version": "first"
          },
          {
            "slot": "call",
            "args": {
              "version": "first"
            }
          },
          {
            "lookup": "outer",
            "version": "first"
          },
          {
            "slot": "result",
            "expanded": false,
            "details": {
              "label": "outer"
            },
            "args": {
              "version": "first"
            },
            "last": null
          },
          {
            "lookup": "different",
            "version": "replacement"
          },
          {
            "slot": "call",
            "args": {
              "version": "replacement"
            }
          },
          {
            "lookup": "inner",
            "version": "replacement"
          },
          {
            "slot": "result",
            "expanded": false,
            "details": {
              "label": "inner"
            },
            "args": {
              "version": "replacement"
            },
            "last": null
          },
          {
            "slot": "result",
            "expanded": true,
            "details": {
              "label": "inner"
            },
            "args": {
              "version": "replacement"
            },
            "last": "inner:false"
          },
          {
            "slot": "result",
            "expanded": true,
            "details": {
              "label": "outer"
            },
            "args": {
              "version": "replacement"
            },
            "last": "outer:false"
          }
        ]
      }
    },
    {
      "test": "export_binding_changes_keep_native_state_per_call",
      "input": {
        "case": "native-edit-replaced",
        "args": {
          "path": "notes.txt"
        },
        "details": {
          "diff": "+1 persisted",
          "firstChangedLine": 1
        }
      },
      "expected": {
        "call": "<div class=\"ansi-line\"><span style=\"background-color:#ff00ff\">                                                                                </span></div><div class=\"ansi-line\"><span style=\"background-color:#ff00ff\"> </span><span style=\"color:#800000;background-color:#ff00ff\"></span><span style=\"color:#800000;background-color:#ff00ff;font-weight:bold\">edit</span><span style=\"color:#800000;background-color:#ff00ff\"></span><span style=\"background-color:#ff00ff\"> </span><span style=\"color:#808000;background-color:#ff00ff\">notes.txt</span><span style=\"background-color:#ff00ff\">                                                                 </span></div><div class=\"ansi-line\"><span style=\"background-color:#ff00ff\">                                                                                </span></div>",
        "result": {
          "expanded": ""
        },
        "settled": "<div class=\"ansi-line\"><span style=\"background-color:#00ffff\">                                                                                </span></div><div class=\"ansi-line\"><span style=\"background-color:#00ffff\"> </span><span style=\"color:#800000;background-color:#00ffff\"></span><span style=\"color:#800000;background-color:#00ffff;font-weight:bold\">edit</span><span style=\"color:#800000;background-color:#00ffff\"></span><span style=\"background-color:#00ffff\"> </span><span style=\"color:#808000;background-color:#00ffff\">notes.txt</span><span style=\"background-color:#00ffff\">                                                                 </span></div><div class=\"ansi-line\"><span style=\"background-color:#00ffff\">                                                                                </span></div><div class=\"ansi-line\"><span style=\"background-color:#00ffff\"> </span><span style=\"color:#ffff00;background-color:#00ffff\">+1 persisted</span><span style=\"background-color:#00ffff\">                                                                   </span></div><div class=\"ansi-line\"><span style=\"background-color:#00ffff\">                                                                                </span></div>",
        "other": "<div class=\"ansi-line\"><span style=\"background-color:#ff00ff\">                                                                                </span></div><div class=\"ansi-line\"><span style=\"background-color:#ff00ff\"> </span><span style=\"color:#800000;background-color:#ff00ff\"></span><span style=\"color:#800000;background-color:#ff00ff;font-weight:bold\">edit</span><span style=\"color:#800000;background-color:#ff00ff\"></span><span style=\"background-color:#ff00ff\"> </span><span style=\"color:#808000;background-color:#ff00ff\">notes.txt</span><span style=\"background-color:#ff00ff\">                                                                 </span></div><div class=\"ansi-line\"><span style=\"background-color:#ff00ff\">                                                                                </span></div>",
        "same_state": true
      }
    }
