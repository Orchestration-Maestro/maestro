  "native": [
    {
      "test": "export_mixed_bindings_require_only_selected_decoder",
      "input": {
        "name": "grep",
        "args": {
          "pattern": "needle",
          "path": "notes.txt"
        },
        "content": [
          {
            "type": "text",
            "text": "one\ntwo"
          }
        ],
        "details": {
          "matchLimitReached": 2
        }
      },
      "expected": {
        "call": "<div class=\"ansi-line\"><span style=\"color:#800000\"></span><span style=\"color:#800000;font-weight:bold\">grep</span><span style=\"color:#800000\"></span> <span style=\"color:#808000\">/needle/</span><span style=\"color:#008000\"> in notes.txt</span>                                                      </div>",
        "result": {
          "expanded": "<div class=\"ansi-line\"><span style=\"color:#008000\">one</span>                                                                             </div><div class=\"ansi-line\"><span style=\"color:#008000\">two</span>                                                                             </div><div class=\"ansi-line\"><span style=\"color:#800080\">[Truncated: 2 matches limit]</span>                                                    </div>"
        }
      }
    },
