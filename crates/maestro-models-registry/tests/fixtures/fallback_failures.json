  {
    "test": "configured_key_does_not_mask_fallback_error",
    "input": {
      "operation": "getAvailable",
      "configured": false,
      "fallback": "error"
    },
    "expected": {
      "branch": "error",
      "error": {
        "message": "Custom credential resolver failed",
        "name": "CustomCredentialFailure",
        "code": "CUSTOM_FALLBACK",
        "cause": {
          "message": "resolver cause",
          "code": "CAUSE"
        }
      },
      "calls": [
        "maestro-custom-fallback"
      ]
    }
  },
