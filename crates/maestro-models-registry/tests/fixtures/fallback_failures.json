  {
    "test": "restoration_keeps_error_and_notice_order",
    "input": {
      "branch": "missing-no-current"
    },
    "expected": {
      "branch": "error",
      "error": {
        "message": "Custom credential resolver failed",
        "name": "CustomCredentialFailure",
        "code": "CUSTOM_FALLBACK",
        "cause": {
          "message": "resolver cause",
          "code": "CAUSE"
        }
      },
      "logs": [
        [
          "stderr",
          "\u001b[33mWarning: Could not restore model maestro-missing/m (model no longer exists).\u001b[39m"
        ]
      ]
    }
  },
  {
    "test": "restoration_keeps_error_and_notice_order",
    "input": {
      "branch": "missing-current"
    },
    "expected": {
      "branch": "ok",
      "value": {
        "result": {
          "model": {
            "provider": "maestro-current",
            "id": "old",
            "name": "Model old"
          },
          "fallbackMessage": "Could not restore model maestro-missing/m (model no longer exists). Using maestro-current/old."
        },
        "logs": [
          [
            "stderr",
            "\u001b[33mWarning: Could not restore model maestro-missing/m (model no longer exists).\u001b[39m"
          ],
          [
            "stdout",
            "\u001b[2mFalling back to: maestro-current/old\u001b[22m"
          ]
        ]
      },
      "logs": [
        [
          "stderr",
          "\u001b[33mWarning: Could not restore model maestro-missing/m (model no longer exists).\u001b[39m"
        ],
        [
          "stdout",
          "\u001b[2mFalling back to: maestro-current/old\u001b[22m"
        ]
      ]
    }
  },
  {
