      "error": "invalid type: null, expected a sequence at line 1 column 16"
    }
  },
  {
    "name": "wrong_messages",
    "input": "{\"messages\":{},\"thinkingLevel\":\"off\",\"model\":null}",
    "expected": {
      "error": "invalid type: map, expected a sequence at line 1 column 12"
    }
  },
  {
    "name": "missing_level",
    "input": "{\"messages\":[],\"model\":null}",
    "expected": {
      "error": "missing field `thinkingLevel` at line 1 column 28"
    }
  },
  {
    "name": "null_level",
    "input": "{\"messages\":[],\"thinkingLevel\":null,\"model\":null}",
