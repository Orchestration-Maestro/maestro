      "error": "invalid type: integer `1`, expected a string at line 1 column 72"
    }
  },
  {
    "name": "missing_model_id",
    "input": "{\"messages\":[],\"thinkingLevel\":\"off\",\"model\":{\"provider\":\"p\"}}",
