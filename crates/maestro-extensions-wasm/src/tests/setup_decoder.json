    }
  },
  {
    "name": "unknown_members",
    "input": "{\"messages\":[],\"thinkingLevel\":\"off\",\"model\":{\"provider\":\"p\",\"modelId\":\"m\",\"unused\":{\"x\":[null]}},\"unused\":false}",
    "expected": {
