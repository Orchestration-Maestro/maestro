      "error": "missing field `modelId` at line 1 column 61"
    }
  },
  {
    "name": "null_model_id",
    "input": "{\"messages\":[],\"thinkingLevel\":\"off\",\"model\":{\"provider\":\"p\",\"modelId\":null}}",
