      "error": "invalid type: null, expected a string at line 1 column 61"
    }
  },
  {
    "name": "wrong_model_id",
    "input": "{\"messages\":[],\"thinkingLevel\":\"off\",\"model\":{\"provider\":\"p\",\"modelId\":1}}",
