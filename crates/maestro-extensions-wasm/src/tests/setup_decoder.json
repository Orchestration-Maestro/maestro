[
  {
    "name": "empty_context",
    "input": "{\"messages\":[],\"thinkingLevel\":\"custom Ω\",\"model\":null}",
    "expected": {
      "messages": [],
      "thinkingLevel": "custom Ω",
      "model": null
    }
  },
  {
    "name": "ordered_messages",
    "input": "{\"messages\":[{\"role\":\"user\",\"content\":\"z\",\"timestamp\":1},{\"role\":\"user\",\"content\":\"a\",\"timestamp\":2},{\"role\":\"user\",\"content\":\"z\",\"timestamp\":3}],\"thinkingLevel\":\"\",\"model\":{\"provider\":\"custom Ω\",\"modelId\":\"x/y\"}}",
    "expected": {
      "messages": [
        {
          "role": "user",
          "content": "z",
          "timestamp": 1.0
        },
        {
          "role": "user",
          "content": "a",
          "timestamp": 2.0
        },
        {
          "role": "user",
          "content": "z",
          "timestamp": 3.0
        }
      ],
      "thinkingLevel": "",
      "model": {
        "provider": "custom Ω",
        "modelId": "x/y"
      }
    }
  },
  {
    "name": "missing_model",
    "input": "{\"messages\":[],\"thinkingLevel\":\"off\"}",
