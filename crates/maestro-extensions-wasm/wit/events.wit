package maestro:extension@0.1.0;

/// Typed event payloads and results.
interface events {
    use models.{image-content};
    use session.{compaction-preparation, compaction-result};

    /// A compaction is about to happen; its cancellation signal travels separately.
    record session-before-compact-event-data {
        preparation: compaction-preparation,
        custom-instructions: option<string>,
    }

    /// Verdict or replacement of a compaction handler.
    record session-before-compact-result {
        cancel: option<bool>,
        compaction: option<compaction-result>,
    }

    /// Where an input came from.
    enum input-source { interactive, rpc, extension }

    /// A user input before agent processing.
    record input-event { text: string, images: option<list<image-content>>, source: input-source }

    /// Replacement text and images of an input.
    record input-transform { text: string, images: option<list<image-content>> }

    /// What an input handler decided.
    variant input-event-result { %continue, transform(input-transform), handled }

    /// Result a handler returns, matching the event it handled.
    variant extension-event-result {
        session-before-compact(session-before-compact-result),
        input(input-event-result),
    }
}
