        get: func() -> result<string, string>;
        set: func(placement: string) -> result<_, string>;
        /// Another owner of the same native record.
        share: func() -> overlay-options;
        /// Replaces or removes the authored visibility check the host runs at each render.
        set-visible: func(visible: option<borrow<callback>>) -> result<_, string>;
    }
    /// One operation on a shown overlay.
    variant overlay-request { hide, set-hidden(bool), is-hidden, focus, unfocus, is-focused }
    /// A shown overlay; requests may call back into this instance while focus moves.
    resource overlay-handle { request: func(request: overlay-request) -> import-route; }
    /// Creates one retained placement owner from its plain record.
    new-overlay-options: func(placement: string) -> result<overlay-options, string>;
    /// Terminal handle lent to a component factory.
    resource tui {
        /// The original frame writer's count of full redraws.
        full-redraws: func() -> result<u64, string>;
        /// The frame writer as a container widget that also takes frame-writer requests.
        writer: func() -> result<widget, string>;
    }
    /// What focus or an overlay goes to: a host widget, an authored component lent now, or the
    /// identity an authored component was lent under before.
    variant writer-target { widget(borrow<widget>), component(borrow<callback>), lent(u32) }
    /// One request on the terminal a frame writer draws on.
    variant terminal-request {
        stop, write(string), columns, rows, kitty-protocol-active, move-by(s64), hide-cursor,
        show-cursor, clear-line, clear-from-cursor, clear-screen, set-title(string),
        set-progress(bool),
    }
    /// One request on a frame writer; focus, overlay and visibility requests may call back into
    /// this instance.
    variant writer-request {
        get-show-hardware-cursor, set-show-hardware-cursor(bool), get-clear-on-shrink,
        set-clear-on-shrink(bool), set-focus(option<writer-target>),
        show-overlay(tuple<writer-target, option<borrow<overlay-options>>>), hide-overlay,
        has-overlay, start, stop, request-render(bool), set-on-debug(option<borrow<callback>>),
        terminal(terminal-request),
        /// Starts the terminal with authored input and resize callbacks.
        terminal-start(tuple<borrow<callback>, borrow<callback>>),
        /// Reads whether the host still keeps the component lent under an identity.
        lent-live(u32),
    }
    /// A host text styling function.
    resource style { apply: func(text: string) -> result<string, string>; }
    /// The host's code highlighting.
    resource highlighter { highlight: func(code: string, lang: option<string>) -> result<list<string>, string>; }
    /// A styling function the host calls: one it supplied, or an authored callback.
    variant style-source { host(borrow<style>), authored(borrow<callback>) }
    /// Code highlighting the host calls: its own, or an authored callback.
    variant highlight-source { host(borrow<highlighter>), authored(borrow<callback>) }
    /// Markdown element styles, code highlighting and code-row prefix.
    record markdown-styles {
        heading: style-source, link: style-source, link-url: style-source, code: style-source,
        code-block: style-source, code-block-border: style-source, quote: style-source,
        quote-border: style-source, hr: style-source, list-bullet: style-source, bold: style-source,
        italic: style-source, strikethrough: style-source, underline: style-source,
        highlight-code: option<highlight-source>, code-block-indent: option<string>,
    }
    /// Markdown styles that read the live theme, with the host's code highlighting.
    record markdown-theme {
        heading: style, link: style, link-url: style, code: style, code-block: style,
        code-block-border: style, quote: style, quote-border: style, hr: style, list-bullet: style,
        bold: style, italic: style, strikethrough: style, underline: style, highlight-code: highlighter,
    }
    /// A text decoration of Markdown's base style.
    enum text-decoration { bold, italic, strikethrough, underline }
    /// Base style of Markdown text.
    record default-text-style {
        color: option<style-source>, bg-color: option<style-source>, decorations: list<text-decoration>,
    }
    /// A child to add to a host container: a host widget, or an authored component.
    variant widget-child { widget(borrow<widget>), component(borrow<callback>) }
    /// A child to remove: a host widget, or the identity an authored component was added under.
    variant child-key { widget(borrow<widget>), component(u32) }
    /// One choice of a selection list.
    record select-item { value: string, label: string, description: option<string> }
    /// What an authored primary-column truncation receives.
    record truncate-context { text: string, max-width: s64, column-width: s64, item: select-item, is-selected: bool }
    /// Selection list styles.
    record select-list-styles {
        selected-prefix: style-source, selected-text: style-source, description: style-source,
        scroll-info: style-source, no-match: style-source,
    }
    /// The live theme's selection list styles.
    record select-list-theme { selected-prefix: style, selected-text: style, description: style, scroll-info: style, no-match: style }
    /// Primary column layout; an absent member keeps the host's default.
    record select-layout {
        min-primary-column-width: option<s64>, max-primary-column-width: option<s64>,
        truncate-primary: option<borrow<callback>>,
    }
    /// A host settings row styling that knows whether the row is selected.
    resource row-style { apply: func(text: string, selected: bool) -> result<string, string>; }
    /// A settings row styling the host calls: one it supplied, or an authored callback.
    variant row-style-source { host(borrow<row-style>), authored(borrow<callback>) }
    /// Settings list styles.
    record settings-list-styles {
        label: row-style-source, value: row-style-source, description: style-source,
        cursor: string, hint: style-source,
    }
    /// The live theme's settings list styles.
    record settings-list-theme { label: row-style, value: row-style, description: style, cursor: string, hint: style }
    /// One setting; values cycle on activation, a submenu opens on activation.
    record setting-item {
        id: string, label: string, description: option<string>, current-value: string,
        values: option<list<string>>, submenu: option<borrow<callback>>,
    }
    /// Closes an open settings submenu, with the chosen value or without one.
    resource submenu-done { done: func(value: option<string>) -> import-route; }
    /// What a widget tells an authored callback.
    variant widget-event {
        select(select-item), cancel, selection-change(select-item), change(tuple<string, string>),
        abort, truncate(truncate-context), row(tuple<string, bool>), submenu(tuple<string, submenu-done>),
        /// An editor's submitted or changed text.
        text(string),
        /// An editor key or action without operands.
        notice,
        /// Input an editor offers its shortcut interceptor first.
        shortcut(string),
        /// An overlay's visibility check at these terminal columns and rows.
        visible(tuple<u32, u32>),
        /// A custom overlay's handle after it is shown.
        overlay-handle(overlay-handle),
        /// A custom overlay asks for its placement.
        overlay-options,
    }
    /// What an authored widget callback answers: nothing, text, a component's identity,
    /// whether a shortcut consumed its input, whether an overlay is visible, or placement.
    variant widget-answer {
        done, text(string), component(callback), consumed(bool), visible(bool),
        overlay-options(overlay-options),
    }
    /// The widget handler an authored callback replaces.
    enum handler-slot {
        select, cancel, selection-change, abort, submit, change, escape, ctrl-d, paste-image,
        extension-shortcut,
    }
