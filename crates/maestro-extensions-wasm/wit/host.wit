    record editor-built { component: callback, editor: callback, custom: option<widget> }
    /// An editor another extension's factory built, and whether it extends the custom editor.
    record built-editor { widget: widget, custom: bool }
    /// One editor operation on an editor another extension's factory built.
    variant foreign-editor-request {
        get-text, set-text(string), set-on-submit(option<borrow<callback>>), on-change,
        set-on-change(option<borrow<callback>>), add-to-history(string),
        insert-text-at-cursor(string), get-expanded-text, border-color,
        set-border-color(style-source), set-padding-x(f64), set-autocomplete-max-visible(f64),
        set-autocomplete-provider(borrow<callback>),
    }
    /// What an editor another extension's factory built answered; `absent` means it lacks the
