package maestro:extension@0.1.0;

/// Capabilities and resources the host provides to an extension.
interface host {
    /// A native update borrowed only while the author's backend is running.
    resource auth-lock-update {
        update: func(current: option<string>) -> result<option<string>, string>;
        update-async: async func(current: option<string>) -> result<option<string>, string>;
    }
    auth-storage-from-backend: func(backend: borrow<callback>) -> import-route;
    /// File constructors resolve absent paths through application-supplied defaults.
    create-auth-storage: func(path: option<string>) -> result<auth-storage, string>;
    auth-storage-in-memory: func(data: string) -> result<auth-storage, string>;
    create-model-registry: func(auth: borrow<auth-storage>, path: option<string>) -> result<model-registry, string>;
    in-memory-model-registry: func(auth: borrow<auth-storage>) -> result<model-registry, string>;
    /// Receiver of unmodified command-output bytes.
    resource bash-output { on-data: func(data: list<u8>) -> result<_, string>; }
    use session.{new-session-command-data, session-change-result};
    /// Writable session capability supplied to new-session setup.
    resource session-manager {
        reader: func() -> readonly-session-manager;
        set-session-file: func(path: string) -> result<_, string>;
        new-session: func(options: option<string>) -> result<option<string>, string>;
        is-persisted: func() -> result<bool, string>;
        get-children: func(parent-id: string) -> result<string, string>;
        build-session-context: func() -> result<string, string>;
        append-message: func(message: string) -> result<string, string>;
        append-thinking-level-change: func(level: string) -> result<string, string>;
        append-model-change: func(provider: string, model-id: string) -> result<string, string>;
        append-compaction: func(compaction: string, from-hook: option<bool>) -> result<string, string>;
        append-custom-entry: func(custom-type: string, data: option<string>) -> result<string, string>;
        append-session-info: func(name: string) -> result<string, string>;
        append-custom-message-entry: func(message: string) -> result<string, string>;
        append-label-change: func(target-id: string, label: option<string>) -> result<string, string>;
        branch: func(from-id: string) -> result<_, string>;
        reset-leaf: func() -> result<_, string>;
        branch-with-summary: func(from-id: option<string>, summary: string, metadata: tuple<option<string>, option<bool>>) -> result<string, string>;
        create-branched-session: func(leaf-id: string) -> result<option<string>, string>;
    }


    /// Color depth a theme renders at.
    enum color-mode { truecolor, color256 }
    /// Independently retained theme; each request reads the host's current state.
    resource theme {
        name: func() -> result<option<string>, string>;
        source-path: func() -> result<option<string>, string>;
        /// Provenance as one JSON document.
        source-info: func() -> result<option<string>, string>;
        set-source-info: func(source: option<string>) -> result<_, string>;
        fg: func(color: string, text: string) -> result<string, string>;
        bg: func(color: string, text: string) -> result<string, string>;
        bold: func(text: string) -> result<string, string>;
        italic: func(text: string) -> result<string, string>;
        underline: func(text: string) -> result<string, string>;
        inverse: func(text: string) -> result<string, string>;
        strikethrough: func(text: string) -> result<string, string>;
        get-fg-ansi: func(color: string) -> result<string, string>;
        get-bg-ansi: func(color: string) -> result<string, string>;
        get-color-mode: func() -> result<color-mode, string>;
        /// Colors text with the border color of a thinking level.
        thinking-border: func(level: string, text: string) -> result<string, string>;
        /// Colors text with the shell mode border color.
        bash-mode-border: func(text: string) -> result<string, string>;
    }
    /// Registers a renderer without invoking it.
    register-message-renderer: func(custom-type: string, handler: borrow<callback>) -> result<_, string>;

    /// Supplied diagnostic fields, mirroring the shared request record.
    variant diagnostic-code { text(string), number(f64) }
    record diagnostic-error-info { name: option<string>, message: string, stack: option<string>, code: option<diagnostic-code> }
    /// The JSON kind of one supplied value.
    enum json-kind { null, boolean, number, %string, array, object }
    /// One method of an executable schema node.
    variant schema-operation { convert, check, errors, refine(u32), message(u32) }
    /// Executable callbacks retained at one schema location.
    record schema-shape { base: bool, refinements: u32 }
    /// Invocation-local JSON access. Paths are relative to the supplied operand.
    resource json-node {
        kind: func(path: string) -> result<option<json-kind>, string>;
        read: func(path: string) -> result<option<string>, string>;
        keys: func(path: string) -> result<list<string>, string>;
        set: func(path: string, key: string, value: string) -> result<_, string>;
        delete: func(path: string, key: string) -> result<_, string>;
        splice: func(path: string, range: tuple<u32, u32>, values: list<string>) -> result<list<string>, string>;
    }
    /// Independently retained callbacks, with author affinity and their original shape.
    record schema-binding { tool: u32, pointer: string, handler: callback, shape: schema-shape, local: bool }
    /// Opaque metadata with independently retained executable annotations.
    record tool-listing { metadata: string, schemas: list<schema-binding> }
    /// Host-owned identity of one guest closure.
    resource callback {
        constructor();
        /// Stable key of this identity, equal for the owner handle and every borrow.
        id: func() -> u32;
        /// Invoke a foreign node through the current synchronous native import route.
        schema-invoke: func(operation: schema-operation, node: borrow<json-node>, path: string) -> import-route;
    }

    /// Independently retained author value, never encoded as JSON.
    resource stream-value {
        constructor(value: callback);
        id: func() -> u32;
    }
    /// Original model invocation buffer, without a second event queue.
    resource assistant-stream {
        push: func(event: string) -> result<_, string>;
        end: func(value: option<string>) -> result<_, string>;
        next: async func() -> result<option<string>, string>;
        %result: async func() -> result<string, string>;
    }
    /// Non-data invocation operands retained independently of the initiating callback.
    record model-controls { signal: option<borrow<abort-signal>>, payload: option<borrow<callback>>, response: option<borrow<callback>>, objects: option<borrow<callback>> }
    /// Invokes immediately; ordinary model, context and options use the shared JSON codec.
    model-stream: func(simple: bool, data: string, controls: model-controls) -> result<assistant-stream, string>;
    /// Native phase calling an awaited authored hook.
    enum model-hook { payload, response }
    /// Selected payload and optional original or replacement cancellation.
    record payload-selection { data: string, signal: option<abort-signal>, owner: option<callback> }
    /// Host-buffered generic authored events and their independent final result.
    resource event-stream {
        push: func(value: stream-value) -> import-route;
        end: func(value: option<stream-value>) -> import-route;
        next: async func() -> result<option<stream-value>, string>;
        %result: async func() -> result<stream-value, string>;
    }
    /// Create the native buffer with synchronous author callbacks.
    new-event-stream: func(classifier: borrow<callback>, extractor: borrow<callback>) -> result<event-stream, string>;
    /// Which synchronous author callback native admission requests.
    enum stream-operation { classify, extract }
    /// Typed result of one author callback.
    variant stream-selection { complete(bool), extracted(stream-value) }
    /// One synchronous callback on the original retained event.
    record local-stream { target: u32, value: u32, operation: stream-operation }

    /// Explicit subscription remover.
    resource subscription { unsubscribe: func() -> result<_, string>; }
    /// Emission capability lent to a synchronous invocation.
    resource callback-emitter;
    /// Registers a bus listener.
    event-on: func(channel: string, handler: borrow<callback>) -> result<subscription, string>;
    /// Emits ordinary data.
    event-emit: async func(channel: string, data: string) -> result<_, string>;
    /// Emits during a synchronous callback.
    callback-emit: func(emitter: borrow<callback-emitter>, channel: string, data: string) -> result<tuple<u32, list<option<u32>>>, string>;
    /// Opens one guest-local prefix with an independent native return boundary.
    callback-begin-local: func(emitter: borrow<callback-emitter>, snapshot: u32, index: u32) -> result<callback-emitter, string>;
    /// Completes a guest-local prefix through the native tail and error owner.
    callback-end-local: func(emitter: borrow<callback-emitter>, error: option<string>) -> import-route;
    /// One nested same-instance renderer call and its owned operands.
    record local-renderer { target: u32, message: string, expanded: bool, theme: theme, emitter: callback-emitter }
    /// One nested same-instance render of a retained component.
    record local-render { target: u32, width: u32, emitter: callback-emitter }
    /// One nested same-instance input or cache invalidation.
    record local-unit { target: u32, data: option<string>, emitter: callback-emitter }
    /// One nested same-instance key-release query.
    record local-key { target: u32, emitter: callback-emitter }
    /// One nested same-instance argument preparation.
    record local-prepare { target: u32, args: string, emitter: callback-emitter }
    /// What a terminal input listener decided; absent members leave the input as it is.
    record terminal-input-result { consume: option<bool>, data: option<string> }
    /// One nested same-instance tool rendering.
    record local-tool-render { target: u32, render: tool-render, theme: theme, invalidator: tool-invalidator, emitter: callback-emitter }
    /// One nested same-instance component factory.
    record local-factory { target: u32, tui: tui, theme: theme, footer: option<footer-data>, emitter: callback-emitter }
    /// One nested same-instance terminal input chunk.
    record local-terminal-input { target: u32, data: string, emitter: callback-emitter }
    /// Selects the authored callback export a nested synchronous call enters.
    enum local-kind { listener, compaction-complete, compaction-error, abort, dispose, branch-change }
    /// One nested same-instance synchronous callback prefix.
    record local-synchronous { target: u32, kind: local-kind, data: string, emitter: callback-emitter }
    /// Host resources lent to one event callback; the signal accompanies a compaction.
    record capabilities { ctx: context, signal: option<abort-signal> }
    /// Invocation identifier and opaque parameter document.
    record tool-invocation { tool-call-id: string, params: string }
    /// Owned resources received by tool execution.
    record tool-capabilities { ctx: context, signal: option<abort-signal>, update: option<tool-update> }
    /// Owned operands of one asynchronous execution.
    record bash-request {
        command: string, cwd: string, timeout: option<f64>,
        env: option<list<tuple<string, option<string>>>>,
    }
    /// Owned callback and cancellation resources for execution.
    record bash-capabilities { output: bash-output, signal: option<abort-signal> }
    /// A JSON document, no document, or the message that explains why encoding failed.
    type encoded = result<option<string>, string>;
    /// How an event callback ended: with an encoded result, or with the message it failed with.
    variant decision { returned(encoded), failed(string) }
    /// Independent edited-event encoding, decision encoding and the identity of returned
    /// operations. Replacing the event kind leaves the edited document absent.
    record event-outcome { event: encoded, decision: decision, operations: option<callback> }
    /// One nested same-instance event callback.
    record local-event { target: u32, event: string, resources: capabilities }
    /// One nested same-instance command.
    record local-command { target: u32, args: string, ctx: command-context }
    /// One nested same-instance argument completion.
    record local-completion { target: u32, prefix: string }
    /// One nested same-instance shortcut.
    record local-shortcut { target: u32, ctx: context }
    /// One nested same-instance tool execution.
    record local-tool { target: u32, invocation: tool-invocation, resources: tool-capabilities }
    /// One nested same-instance session setup.
    record local-setup { target: u32, writer: session-manager }
    /// One nested same-instance session continuation.
    record local-continuation { target: u32, ctx: replaced-session-context }
    /// One nested same-instance execution of returned shell operations.
    record local-bash { target: u32, request: bash-request, resources: bash-capabilities }
    /// One nested same-instance schema method over the operand its native caller lends.
    record local-schema { target: u32, operation: schema-operation, node: json-node, emitter: callback-emitter }
    record local-auth-backend { target: u32, update: auth-lock-update, asynchronous: bool }
    record local-auth-fallback { target: u32, provider: string }
    /// The nested same-instance target and its owned operands.
    variant local-call {
        oauth(local-oauth-callback),
        auth-backend(local-auth-backend),
        auth-fallback(local-auth-fallback),
        renderer(local-renderer),
        render(local-render),
        unit(local-unit),
        key(local-key),
        prepare(local-prepare),
        terminal-input(local-terminal-input),
        synchronous(local-synchronous),
        schema(local-schema),
        %stream(local-stream),
        event(local-event),
        command(local-command),
        completion(local-completion),
        shortcut(local-shortcut),
        tool(local-tool),
        setup(local-setup),
        with-session(local-continuation),
        tail(u32),
        bash(local-bash),
        factory(local-factory),
        tool-render(local-tool-render),
    }
    /// The nested call's own result, returned to the native caller that asked for it.
    variant local-result {
        oauth(result<option<string>, string>),
        auth-fallback(result<option<string>, string>),
        renderer(result<option<callback>, string>),
        render(result<list<string>, string>),
        unit(result<_, string>),
        key(result<bool, string>),
        prepared(result<string, string>),
        terminal-input(result<option<terminal-input-result>, string>),
        synchronous(result<_, string>),
        schema(result<string, diagnostic-error-info>),
        %stream(result<stream-selection, string>),
        event(result<event-outcome, string>),
        completion(result<option<list<autocomplete-item>>, string>),
        tool(result<string, string>),
        bash(result<option<f64>, string>),
        factory(result<factory-component, string>),
        tool-render(result<tool-rendered, string>),
    }
    /// One step of a native operation that may call back into this same instance.
    variant route-value { unit, boolean(bool), text(string), credentials(auth-storage), catalog(model-registry) }
    variant route-step { invoke(local-call), done(result<route-value, string>) }
    /// A native operation in progress on this instance, advanced by the guest.
    resource import-route {
        next: func() -> route-step;
        resume: func(value: local-result);
        /// Releases the native caller once the nested call's prefix ran; its result follows.
        defer: func() -> local-settlement;
        /// Take a completed schema import's original structured result.
        schema-result: func() -> result<string, diagnostic-error-info>;
    }
    /// A nested call whose prefix ran and whose result the guest delivers later.
    resource local-settlement { finish: func(value: local-result); }
    /// Runs a consecutive host segment before continuing the guest-local walk.
    callback-segment: func(emitter: borrow<callback-emitter>, snapshot: u32, start: u32, end: u32) -> import-route;
    /// Releases a snapshot after traversal, including a failed traversal.
    callback-end-snapshot: func(emitter: borrow<callback-emitter>, snapshot: u32) -> result<_, string>;
    /// Announces an independently owned tail.
    start-event-tail: func(emitter: borrow<callback-emitter>, tail: borrow<callback>) -> result<_, string>;

    /// Host-owned cancellation flag.
    resource abort-signal {
        retain: func() -> abort-signal;
        aborted: func() -> bool;
        abort: func() -> import-route;
    }
    /// Creates an independently owned cancellation signal.
    new-signal: func() -> result<abort-signal, string>;
    /// Calls the host with ordinary data and an optional borrowed cancellation signal.
    call: async func(operation: string, data: string, signal: option<borrow<abort-signal>>) -> result<string, string>;
    /// Runs a listener once when the signal is cancelled; the subscription removes it.
    signal-subscribe: func(signal: borrow<abort-signal>, listener: borrow<callback>) -> result<subscription, string>;

    /// Partial output delivered by an executing tool.
    resource tool-update { update: func(partial: string) -> import-route; }

    /// Independently retained read-only session.
    resource readonly-session-manager {
        get-cwd: func() -> result<string, string>;
        get-session-dir: func() -> result<string, string>;
        get-session-id: func() -> result<string, string>;
        get-session-file: func() -> result<option<string>, string>;
        get-leaf-id: func() -> result<option<string>, string>;
        get-leaf-entry: func() -> result<option<string>, string>;
        get-entry: func(id: string) -> result<option<string>, string>;
        get-label: func(id: string) -> result<option<string>, string>;
        get-branch: func(from-id: option<string>) -> result<string, string>;
        get-header: func() -> result<option<string>, string>;
        get-entries: func() -> result<string, string>;
        get-tree: func() -> result<list<session-tree-node>, string>;
        get-session-name: func() -> result<option<string>, string>;
    }
    /// Independently retained tree node.
    resource session-tree-node {
        entry: func() -> result<string, string>;
        children: func() -> result<list<session-tree-node>, string>;
        label: func() -> result<option<string>, string>;
        label-timestamp: func() -> result<option<string>, string>;
    }


    /// Supplied context usage estimates.
    record context-usage {
        /// Unknown estimates are absent.
        tokens: option<f64>,
        /// Supplied context capacity.
        context-window: f64,
        /// Supplied percentage, or an unknown estimate.
        percent: option<f64>,
    }
    /// Severity of a notification; absent means an ordinary message.
    enum notification-type { info, warning, error }
    /// Vertical position of a fixed widget.
    enum widget-placement { above-editor, below-editor }
    /// Options of a fixed widget; the host chooses the default placement.
    record extension-widget-options {
        /// Omitted keeps the host's default placement.
        placement: option<widget-placement>,
    }
    /// Options of the working indicator; the host owns animation and defaults.
    record working-indicator-options {
        /// Omitted keeps the host's default frames; an empty list hides the indicator.
        frames: option<list<string>>,
        /// Omitted keeps the host's default interval.
        interval-ms: option<f64>,
    }
    /// Terminal handle lent to a component factory.
    resource tui;
    /// Which renderer a tool rendering enters.
    enum tool-render-slot { call, %result }
    /// What a tool renderer reads about its row at this rendering.
    record tool-render-info {
        tool-call-id: string, args: option<string>, cwd: string, phase: tool-render-phase,
        expanded: bool, show-images: bool, is-error: bool,
    }
    /// Execution progress of a tool row.
    record tool-render-phase { execution-started: bool, args-complete: bool, is-partial: bool }
    /// One tool rendering: the renderer slot, the identity of the row's guest state once it
    /// has one, the row context and the independently supplied callback operands.
    record tool-render { slot: tool-render-slot, row: option<u32>, info: tool-render-info, args: option<string>, %result: option<string>, options: option<tool-render-result-options> }
    /// Options supplied to the result callback independently of the row context.
    record tool-render-result-options { expanded: bool, is-partial: bool }
    /// A tool rendering's component or error, with new row state retained in either case.
    record tool-rendered { component: result<callback, string>, row: option<callback> }
    /// Redraws one tool row.
    resource tool-invalidator { invalidate: func() -> result<_, string>; }
    /// The footer metadata a footer factory may read; each read is current.
    resource footer-data {
        get-git-branch: func() -> result<option<string>, string>;
        get-extension-statuses: func() -> result<list<tuple<string, string>>, string>;
        get-available-provider-count: func() -> result<f64, string>;
        /// Calls the listener when the branch may have changed; dropping the subscription keeps it.
        on-branch-change: func(listener: borrow<callback>) -> result<subscription, string>;
    }
    /// A component a factory built, with the disposal the host calls when it removes it.
    record factory-component { component: callback, dispose: option<callback> }
    /// One available theme; a theme without a file has no path.
    record theme-info { name: string, path: option<string> }
    /// Whether a theme selection applied, with the host's message when it did not.
    record theme-set-result { success: bool, error: option<string> }
    /// Independently retained opaque UI capability.
    resource extension-ui-context {
        notify: func(message: string, kind: option<notification-type>) -> import-route;
        set-status: func(key: string, text: option<string>) -> import-route;
        set-working-message: func(message: option<string>) -> import-route;
        set-working-visible: func(visible: bool) -> import-route;
        set-working-indicator: func(options: option<working-indicator-options>) -> import-route;
        set-hidden-thinking-label: func(label: option<string>) -> import-route;
        set-widget: func(key: string, content: option<list<string>>, options: option<extension-widget-options>) -> import-route;
        /// Replaces the footer with the component a factory builds, or restores the host footer.
        set-footer: func(factory: option<borrow<callback>>) -> import-route;
        /// Replaces the header with the component a factory builds, or restores the host header.
        set-header: func(factory: option<borrow<callback>>) -> import-route;
        /// Shows the component a factory builds; the host disposes the widget it replaces first.
        set-widget-factory: func(key: string, factory: borrow<callback>, options: option<extension-widget-options>) -> import-route;
        set-title: func(title: string) -> import-route;
        paste-to-editor: func(text: string) -> import-route;
        set-editor-text: func(text: string) -> import-route;
        get-editor-text: func() -> result<string, string>;
        /// Adds a raw terminal input listener; dropping the subscription keeps it.
        on-terminal-input: func(handler: borrow<callback>) -> result<subscription, string>;
        /// The live theme of this UI.
        theme: func() -> result<theme, string>;
        /// Every available theme in the host's order.
        get-all-themes: func() -> result<list<theme-info>, string>;
        /// Loads a theme by name without selecting it.
        get-theme: func(name: string) -> result<option<theme>, string>;
        /// Selects a theme by name.
        set-theme-name: func(name: string) -> result<theme-set-result, string>;
        /// Selects a retained theme.
        set-theme: func(theme: borrow<theme>) -> result<theme-set-result, string>;
        get-tools-expanded: func() -> result<bool, string>;
        set-tools-expanded: func(expanded: bool) -> import-route;
        /// Resolves to the chosen option, or none on dismissal.
        select: async func(title: string, options: list<string>, signal: option<borrow<abort-signal>>, timeout: option<f64>) -> result<option<string>, string>;
        /// Resolves to false on dismissal.
        confirm: async func(title: string, message: string, signal: option<borrow<abort-signal>>, timeout: option<f64>) -> result<bool, string>;
        /// Resolves to the entered line, or none on dismissal.
        input: async func(title: string, placeholder: option<string>, signal: option<borrow<abort-signal>>, timeout: option<f64>) -> result<option<string>, string>;
        /// Resolves to the edited text, or none on dismissal.
        editor: async func(title: string, prefill: option<string>) -> result<option<string>, string>;
    }
    /// Resolved credentials, retaining key and header presence.
    record request-auth {
        api-key: option<string>,
        headers: option<list<tuple<string, string>>>,
    }
    /// Resolution outcome, separate from an import failure.
    variant resolved-request-auth { ok(request-auth), error(string) }
    /// Independently retained accepted credentials and their original backend.
    /// Independently retained native OAuth implementation.
    enum oauth-callback { auth, prompt, progress, manual, select, key, models, refresh, login }
    resource oauth-interaction {
        options: func() -> tuple<bool, bool, bool>;
        signal: func() -> option<abort-signal>;
        notify: func(phase: oauth-callback, data: string) -> import-route;
        input: async func(phase: oauth-callback, data: string) -> result<option<string>, string>;
    }
    record local-oauth-callback { target: u32, phase: oauth-callback, data: string, interaction: option<oauth-interaction> }
    resource oauth-provider {
        login: async func(callbacks: borrow<callback>, options: tuple<bool, bool, bool>, signal: option<borrow<abort-signal>>) -> result<string, string>;
        info: func() -> result<string, string>;
        get-api-key: func(credentials: string) -> import-route;
        refresh-token: async func(credentials: string) -> result<string, string>;
        modify-models: func(data: string) -> import-route;
    }
    resource auth-storage {
        login: async func(provider: string, callbacks: borrow<callback>, options: tuple<bool, bool, bool>, signal: option<borrow<abort-signal>>) -> result<_, string>;
        get-oauth-providers: func() -> result<list<oauth-provider>, string>;
        set-fallback-resolver: func(resolver: borrow<callback>) -> import-route;
        set-runtime-api-key: func(provider: string, key: string) -> result<_, string>;
        remove-runtime-api-key: func(provider: string) -> result<_, string>;
        reload: func() -> import-route;
        get: func(provider: string) -> result<option<string>, string>;
        set: func(provider: string, credential: string) -> import-route;
        remove: func(provider: string) -> import-route;
        %list: func() -> result<list<string>, string>;
        has: func(provider: string) -> result<bool, string>;
        has-auth: func(provider: string) -> import-route;
        get-auth-status: func(provider: string) -> import-route;
        get-all: func() -> result<string, string>;
        drain-errors: func() -> result<string, string>;
        logout: func(provider: string) -> import-route;
        get-api-key: async func(provider: string, include-fallback: option<bool>) -> result<option<string>, string>;
    }

    /// Independently retained host catalog.
    resource model-registry {
        auth-storage: func() -> result<auth-storage, string>;
        get-all: func() -> result<string, string>;
        get-available: func() -> import-route;
        find: func(provider: string, model-id: string) -> result<option<string>, string>;
        get-api-key-and-headers: async func(model: string) -> result<resolved-request-auth, string>;
        refresh: func() -> import-route;
        get-error: func() -> result<option<string>, string>;
        has-configured-auth: func(model: string) -> import-route;
        /// The provider's authentication status as JSON.
        get-provider-auth-status: func(provider: string) -> import-route;
        get-provider-display-name: func(provider: string) -> result<string, string>;
        is-using-oauth: func(model: string) -> result<bool, string>;
        /// Registers JSON provider data directly in this catalog.
        register-provider: func(name: string, config: string, oauth: option<tuple<borrow<callback>, string, option<bool>>>) -> import-route;
        unregister-provider: func(name: string) -> import-route;
        get-api-key-for-provider: async func(provider: string) -> result<option<string>, string>;
    }

    /// Plain compaction options, separate from their retained callbacks.
    record compaction-data { custom-instructions: option<string> }

    /// Live capabilities available to every callback.
    resource context {
        ui: func() -> result<extension-ui-context, string>;
        has-ui: func() -> result<bool, string>;
        model-registry: func() -> result<model-registry, string>;
        model: func() -> result<option<string>, string>;
        is-idle: func() -> result<bool, string>;
        signal: func() -> result<option<abort-signal>, string>;
        abort: func() -> import-route;
        has-pending-messages: func() -> result<bool, string>;
        shutdown: func() -> import-route;
        get-context-usage: func() -> result<option<context-usage>, string>;
        get-system-prompt: func() -> result<string, string>;
        compact: func(options: option<compaction-data>, on-complete: option<borrow<callback>>, on-error: option<borrow<callback>>) -> import-route;

        cwd: func() -> result<string, string>;
        session-manager: func() -> result<readonly-session-manager, string>;
    }

    /// Optional continuation of a session switch.
    record switch-session-options { with-session: option<borrow<callback>> }

    /// Context with the session-replacing operations; only commands receive it.
    resource command-context {

        ui: func() -> result<extension-ui-context, string>;
        has-ui: func() -> result<bool, string>;
        model-registry: func() -> result<model-registry, string>;
        model: func() -> result<option<string>, string>;
        is-idle: func() -> result<bool, string>;
        signal: func() -> result<option<abort-signal>, string>;
        abort: func() -> import-route;
        has-pending-messages: func() -> result<bool, string>;
        shutdown: func() -> import-route;
        get-context-usage: func() -> result<option<context-usage>, string>;
        get-system-prompt: func() -> result<string, string>;
        compact: func(options: option<compaction-data>, on-complete: option<borrow<callback>>, on-error: option<borrow<callback>>) -> import-route;

        cwd: func() -> result<string, string>;
        session-manager: func() -> result<readonly-session-manager, string>;
        wait-for-idle: async func() -> result<_, string>;
        new-session: async func(
            data: option<new-session-command-data>, setup: option<borrow<callback>>, with-session: option<borrow<callback>>,
        ) -> result<session-change-result, string>;
        fork: async func(entry-id: string, data: option<string>, with-session: option<borrow<callback>>) -> result<session-change-result, string>;
        navigate-tree: async func(target-id: string, options: option<string>) -> result<session-change-result, string>;
        switch-session: async func(path: string, options: option<switch-session-options>) -> result<session-change-result, string>;
        reload: async func() -> result<_, string>;
    }

    /// Context bound to the session an operation created.
    resource replaced-session-context {


        command: func() -> command-context;
        send-message: async func(message: string, options: option<string>) -> result<_, string>;
        send-user-message: async func(content: string, options: option<string>) -> result<_, string>;
    }

    /// Registers one handler for an event name.
    on: func(event: string, handler: borrow<callback>) -> result<_, string>;
    /// One completion candidate.
    record autocomplete-item {
        /// Text inserted by the consumer.
        value: string,
        /// Authored display label.
        label: string,
        /// Optional authored description.
        description: option<string>,
    }
    /// Declared flag kind, independent of its default's variant.
    enum flag-type { boolean, %string }
    /// One supplied flag value.
    variant flag-value { boolean(bool), %string(string) }
    /// Registration options; the host chooses when the default applies.
    record flag-options {
        /// Optional authored description.
        description: option<string>,
        /// Declared parser kind.
        %type: flag-type,
        /// Optional default, independently typed from the kind.
        %default: option<flag-value>,
    }
    /// Registers a literal shortcut.
    register-shortcut: func(shortcut: string, description: option<string>, handler: borrow<callback>) -> result<_, string>;
    /// Registers a flag.
    register-flag: func(name: string, options: flag-options) -> result<_, string>;
    /// Reads the host-resolved flag value.
    get-flag: func(name: string) -> result<option<flag-value>, string>;
    /// Registers a command.
    register-command: func(
        name: string, description: option<string>, completions: option<borrow<callback>>, handler: borrow<callback>,
    ) -> result<_, string>;
    /// Registers authored tool data and callbacks.
    register-tool: async func(metadata: string, prepare: option<borrow<callback>>, execute: borrow<callback>, schemas: list<tuple<string, borrow<callback>>>, render-call: option<borrow<callback>>, render-result: option<borrow<callback>>) -> import-route;
    /// Registers JSON provider data, queued until the host binds.
    register-provider: func(name: string, config: string, oauth: option<tuple<borrow<callback>, string, option<bool>>>) -> import-route;
    /// Unregisters a provider, including its queued registrations.
    unregister-provider: func(name: string) -> import-route;
    /// Appends a custom entry to the session; `data` is JSON text.
    append-entry: func(custom-type: string, data: option<string>) -> import-route;

    send-message: func(message: string, options: option<string>) -> import-route;
    send-user-message: func(content: string, options: option<string>) -> import-route;
    set-session-name: func(name: string) -> import-route;
    get-session-name: func() -> result<option<string>, string>;
    set-label: func(entry-id: string, label: option<string>) -> import-route;
    get-active-tools: func() -> result<list<string>, string>;
    get-all-tools: async func() -> result<tool-listing, string>;
    set-active-tools: func(tool-names: list<string>) -> import-route;
    get-commands: func() -> result<string, string>;
    set-model: async func(model: string) -> result<bool, string>;
    get-thinking-level: func() -> result<string, string>;
    set-thinking-level: func(level: string) -> import-route;
}
