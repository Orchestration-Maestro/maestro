package maestro:extension@0.1.0;

/// Callbacks the host invokes on the extension.
interface guest {
    use host.{theme};
    /// Renderer input with owned theme and complete message document.
    record render-request { message: string, expanded: bool, theme: theme }
    /// Retained authored component, owned by the receiving host.
    resource component-view {
        render: func(width: u32, emitter: borrow<callback-emitter>) -> result<list<string>, string>;
        handle-input: func(data: string, emitter: borrow<callback-emitter>) -> result<_, string>;
        wants-key-release: func(emitter: borrow<callback-emitter>) -> result<bool, string>;
        invalidate: func(emitter: borrow<callback-emitter>) -> result<_, string>;
    }
    /// Runs a synchronous renderer and transfers its returned component.
    invoke-renderer: func(handler: borrow<callback>, request: render-request, emitter: borrow<callback-emitter>) -> result<option<component-view>, string>;

    invoke-setup: async func(handler: borrow<callback>, writer: session-manager) -> result<_, string>;
    use host.{autocomplete-item, callback-emitter, tool-update, session-manager, callback, abort-signal, context, command-context, replaced-session-context};

    /// Host resources lent to one event callback; the signal accompanies a compaction.
    record capabilities { ctx: context, signal: option<abort-signal> }

    /// Invocation identifier and opaque parameter document.
    record tool-invocation { tool-call-id: string, params: string }
    /// Owned resources received by tool execution.
    record tool-capabilities { ctx: context, signal: option<abort-signal>, update: option<tool-update> }
    /// Synchronously prepares arguments.
    invoke-prepare: func(handler: borrow<callback>, args: string, emitter: borrow<callback-emitter>) -> result<string, string>;
    /// Runs a synchronous listener prefix.
    invoke-listener: func(handler: borrow<callback>, data: string, emitter: borrow<callback-emitter>) -> result<_, string>;
    /// Awaits an independently retained listener tail.
    invoke-tail: async func(handler: borrow<callback>) -> result<_, string>;
    /// Awaits execution of a tool.
    invoke-tool: async func(handler: borrow<callback>, invocation: tool-invocation, resources: tool-capabilities) -> result<string, string>;

    /// A JSON document, no document, or the message that explains why encoding failed.
    type encoded = result<option<string>, string>;

    /// How an event callback ended: with an encoded result, or with the message it failed with.
    variant decision { returned(encoded), failed(string) }

    /// An event after its callback ran. The two parts are independent: the event is the
    /// callback's edit, whether it returned or failed, and is absent only when the callback
    /// replaced it with an event of another kind.
    record event-outcome { event: encoded, decision: decision }

    /// Runs the extension factory; returns when it has completed.
    start: async func() -> result<_, string>;
    /// Removes the callback table entry; independent aliases and admitted futures may retain captures.
    release: func(handler: borrow<callback>);
    /// Runs a command handler.
    invoke-command: async func(
        handler: borrow<callback>, args: string, ctx: command-context,
    ) -> result<_, string>;
    /// Runs the optional argument-completion callback.
    invoke-completion: async func(handler: borrow<callback>, prefix: string) -> result<option<list<autocomplete-item>>, string>;
    /// Runs a shortcut callback with an ordinary context.
    invoke-shortcut: async func(handler: borrow<callback>, ctx: context) -> result<_, string>;
    /// Runs the continuation of a session operation.
    invoke-with-session: async func(
        handler: borrow<callback>, ctx: replaced-session-context,
    ) -> result<_, string>;
    /// Delivers one event, a JSON document tagged with its kind, to an event handler. An error
    /// means the document or its resources were rejected before the handler ran.
    invoke-event: async func(
        handler: borrow<callback>, event: string, resources: capabilities,
    ) -> result<event-outcome, string>;
    invoke-compaction-complete: func(handler: borrow<callback>, %result: string, emitter: borrow<callback-emitter>) -> result<_, string>;
    invoke-compaction-error: func(handler: borrow<callback>, error: string, emitter: borrow<callback-emitter>) -> result<_, string>;
}
