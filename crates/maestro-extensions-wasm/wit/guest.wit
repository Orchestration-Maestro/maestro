package maestro:extension@0.1.0;

/// Callbacks the host invokes on the extension.
interface guest {
    use host.{auth-lock-update};
    invoke-auth-backend: async func(handler: borrow<callback>, update: borrow<auth-lock-update>, asynchronous: bool) -> result<_, string>;
    invoke-auth-fallback: async func(handler: borrow<callback>, provider: string) -> result<option<string>, string>;
    use host.{theme, json-node, schema-shape, schema-operation, diagnostic-error-info};
    use host.{stream-operation, stream-selection, model-hook, payload-selection, abort-signal};
    /// Await the original payload selector or response observer.
    invoke-model-hook: async func(handler: borrow<callback>, phase: model-hook, data: string, model: string, signal: option<abort-signal>) -> result<payload-selection, string>;
    /// Run a synchronous stream callback on its original retained local event.
    invoke-stream: async func(handler: borrow<callback>, value: borrow<callback>, operation: stream-operation) -> result<stream-selection, string>;
    invoke-schema: async func(handler: borrow<callback>, operation: schema-operation, node: borrow<json-node>, emitter: borrow<callback-emitter>) -> result<string, diagnostic-error-info>;
    /// Read callbacks retained at this originating node.
    describe-schema: func(handler: borrow<callback>) -> result<schema-shape, diagnostic-error-info>;
    /// Retain the originating callbacks under a fresh host-supplied identity.
    retain-schema: func(handler: borrow<callback>, retained: callback) -> result<_, diagnostic-error-info>;
    /// Renderer input with owned theme and complete message document.
    record render-request { message: string, expanded: bool, theme: theme }
    /// Renders one retained authored component.
    component-render: async func(handler: borrow<callback>, width: u32, emitter: borrow<callback-emitter>) -> result<list<string>, string>;
    /// Delivers input to one retained authored component.
    component-handle-input: async func(handler: borrow<callback>, data: string, emitter: borrow<callback-emitter>) -> result<_, string>;
    /// Reads the key-release preference of one retained authored component.
    component-wants-key-release: async func(handler: borrow<callback>, emitter: borrow<callback-emitter>) -> result<bool, string>;
    /// Invalidates one retained authored component.
    component-invalidate: async func(handler: borrow<callback>, emitter: borrow<callback-emitter>) -> result<_, string>;
    /// Runs a synchronous renderer and transfers the identity of its returned component.
    invoke-renderer: async func(handler: borrow<callback>, request: render-request, emitter: borrow<callback-emitter>) -> result<option<callback>, string>;

    invoke-setup: async func(handler: borrow<callback>, writer: session-manager) -> result<_, string>;
    use host.{autocomplete-item, callback-emitter, session-manager, callback, context, command-context, replaced-session-context};
    use host.{widget-event, widget-answer};
    use host.{capabilities, tool-invocation, tool-capabilities, bash-request, bash-capabilities, encoded, decision, event-outcome, terminal-input-result, tui, factory-component, footer-data, tool-render, tool-rendered, tool-invalidator};
    /// Executes returned shell operations kept under one callback identity.
    bash-exec: async func(handler: borrow<callback>, request: bash-request, resources: bash-capabilities) -> result<option<f64>, string>;

    /// Synchronously prepares arguments.
    invoke-prepare: async func(handler: borrow<callback>, args: string, emitter: borrow<callback-emitter>) -> result<string, string>;
    /// Runs a synchronous listener prefix.
    invoke-listener: async func(handler: borrow<callback>, data: string, emitter: borrow<callback-emitter>) -> result<_, string>;
    /// Awaits an independently retained listener tail.
    invoke-tail: async func(handler: borrow<callback>) -> result<_, string>;
    /// Awaits execution of a tool.
    invoke-tool: async func(handler: borrow<callback>, invocation: tool-invocation, resources: tool-capabilities) -> result<string, string>;

    /// Runs the extension factory; returns when it has completed.
    start: async func() -> result<_, string>;
    /// Removes the callback table entry; independent aliases and admitted futures may retain captures.
    release: func(handler: borrow<callback>);
    /// Runs a command handler.
    invoke-command: async func(
        handler: borrow<callback>, args: string, ctx: command-context,
    ) -> result<_, string>;
    /// Runs the optional argument-completion callback.
    invoke-completion: async func(handler: borrow<callback>, prefix: string) -> result<option<list<autocomplete-item>>, string>;
    /// Runs a shortcut callback with an ordinary context.
    invoke-shortcut: async func(handler: borrow<callback>, ctx: context) -> result<_, string>;
    /// Runs the continuation of a session operation.
    invoke-with-session: async func(
        handler: borrow<callback>, ctx: replaced-session-context,
    ) -> result<_, string>;
    /// Delivers one event, a JSON document tagged with its kind, to an event handler. An error
    /// means the document or its resources were rejected before the handler ran.
    invoke-event: async func(
        handler: borrow<callback>, event: string, resources: capabilities,
    ) -> result<event-outcome, string>;
    invoke-compaction-complete: async func(handler: borrow<callback>, %result: string, emitter: borrow<callback-emitter>) -> result<_, string>;
    invoke-compaction-error: async func(handler: borrow<callback>, error: string, emitter: borrow<callback-emitter>) -> result<_, string>;
    /// Runs a cancellation listener once with its synchronous emitter.
    invoke-abort: async func(handler: borrow<callback>, emitter: borrow<callback-emitter>) -> result<_, string>;
    /// Runs a component factory and transfers the identities of its component and disposal.
    invoke-component-factory: async func(handler: borrow<callback>, tui: tui, theme: theme, footer: option<footer-data>, emitter: borrow<callback-emitter>) -> result<factory-component, string>;
    /// Runs a tool's call or result renderer for one row.
    invoke-tool-render: async func(handler: borrow<callback>, render: tool-render, theme: theme, invalidator: tool-invalidator, emitter: borrow<callback-emitter>) -> result<tool-rendered, string>;
    /// Runs a branch change listener with its synchronous emitter.
    invoke-branch-change: async func(handler: borrow<callback>, emitter: borrow<callback-emitter>) -> result<_, string>;
    /// Changes a retained factory component's expansion.
    invoke-set-expanded: async func(handler: borrow<callback>, expanded: bool, emitter: borrow<callback-emitter>) -> result<_, string>;
    /// Runs a component's disposal once with its synchronous emitter.
    invoke-dispose: async func(handler: borrow<callback>, emitter: borrow<callback-emitter>) -> result<_, string>;
    /// Styles text with an authored styling function.
    invoke-style: async func(handler: borrow<callback>, text: string) -> result<string, string>;
    /// Highlights code with an authored highlighting function.
    invoke-highlight: async func(handler: borrow<callback>, code: string, lang: option<string>) -> result<list<string>, string>;
    /// Runs an authored widget callback with its synchronous emitter.
    invoke-widget: async func(handler: borrow<callback>, event: widget-event, emitter: borrow<callback-emitter>) -> result<widget-answer, string>;
    /// Runs a terminal input listener on one chunk with its synchronous emitter.
    invoke-terminal-input: async func(handler: borrow<callback>, data: string, emitter: borrow<callback-emitter>) -> result<option<terminal-input-result>, string>;
}
