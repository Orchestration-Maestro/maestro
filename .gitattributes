# Default to LF for text files across the repo
* text=auto eol=lf

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should keep LF
*.sh text eol=lf

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary

# Image protocol byte fixtures
crates/maestro-terminal/tests/fixtures/images/* binary

# Empty trailing TSV fields are significant in locale recipes.
crates/maestro-text/data/date-time/recipes.tsv whitespace=-blank-at-eol
