package maestro:extension@0.1.0;

/// Fixed data records and host-owned resources shared by both directions.
interface types {
    /// Where an input came from.
    enum input-source { interactive, rpc, extension }

    /// A user input about to be processed.
    record input-event {
        text: string,
        images: option<list<string>>,
        source: input-source,
    }

    /// Replacement text and images for an input.
    record input-replacement {
        text: string,
        images: option<list<string>>,
    }

    /// What an input handler decided.
    variant input-result {
        %continue,
        transform(input-replacement),
        handled,
    }

    /// The event as the handler left it, together with the handler's result.
    record input-outcome {
        event: input-event,
        decision: result<option<input-result>, string>,
    }

    /// Registration data of one tool; its callbacks travel as separate parameters.
    record tool-metadata {
        name: string,
        label: string,
        description: string,
        parameters-schema: string,
    }

    /// Result of one tool call; `details` is JSON text.
    record tool-result {
        content: list<string>,
        details: option<string>,
        terminate: option<bool>,
    }

    /// Custom message handed to a renderer.
    record custom-message {
        custom-type: string,
        content: string,
        details: option<string>,
    }

    /// Whether the session switch was cancelled.
    record session-change-result {
        cancelled: bool,
    }

    /// Plain-data options of a new session; its callback is a separate parameter.
    record new-session-options {
        parent-session: option<string>,
    }

    /// Host-owned identity of one guest closure.
    resource callback {
        constructor();
        /// Stable key of this identity, equal for the owner handle and every borrow.
        id: func() -> u32;
    }

    /// Host-owned cancellation flag.
    resource abort-signal {
        aborted: func() -> bool;
    }

    /// Host-owned channel for partial tool results.
    resource tool-update {
        send: func(partial: tool-result) -> result<_, string>;
    }

    /// Live session capabilities available to every callback.
    resource context {
        cwd: func() -> result<string, string>;
        signal: func() -> result<option<abort-signal>, string>;
    }

    /// Context with the session-replacing operations; only commands receive it.
    resource command-context {
        cwd: func() -> result<string, string>;
        signal: func() -> result<option<abort-signal>, string>;
        new-session: async func(
            options: new-session-options,
            with-session: option<borrow<callback>>,
        ) -> result<session-change-result, string>;
    }

    /// Context bound to the session an operation created.
    resource replaced-session-context {
        command: func() -> command-context;
        send-user-message: async func(text: string) -> result<_, string>;
    }
}
